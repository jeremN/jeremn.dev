---
import Layout from '../layouts/Layout.astro'
import Underline from '../components/site/Underline.astro'
import { VARIANTS } from '../components/hero-lab/types'
import { withBase } from '../lib/base'
---
<Layout title="Black-hole physics lab · jeremn.dev" noindex>
  <main class="relative z-10 mx-auto max-w-6xl px-6 pb-16 pt-16 sm:pt-24">
    <span class="font-mono text-[11px] uppercase tracking-wider text-accent">Lab / not shipped</span>
    <h1 class="mt-6 max-w-[18ch] font-display text-4xl font-medium leading-[1.05] tracking-tight text-ink sm:text-5xl">
      Black-hole physics, <span class="relative inline-block">
        six ways.
        <Underline class="absolute -bottom-1 left-0 w-full text-accent" />
      </span>
    </h1>
    <p class="mt-6 max-w-[56ch] font-sans text-base leading-relaxed text-muted">
      The same galaxy and the same cursor in every tile. Only the warp law changes.
    </p>
    <a href={withBase('/hero-lab/galaxy')} class="mt-6 inline-block font-mono text-[11px] uppercase tracking-wider text-accent no-underline">
      The retired v1 galaxy hero →
    </a>

    <div class="relative mt-8 h-[78vh] min-h-[600px] w-full overflow-hidden rounded-lg border border-line">
      <canvas id="lab" class="absolute inset-0 block h-full w-full"></canvas>
      {/* The canvas behind these tiles is opaque black in either theme, so the
          overlay pins the dark tokens the same way the galaxy band does. Under
          the light palette `bg-ground/55` resolved to a mid grey and the muted
          body text measured about 1.9:1. */}
      <div class="hero-dark pointer-events-none absolute inset-0 grid grid-cols-3 grid-rows-2">
        {VARIANTS.map((v) => (
          <div class="relative border border-line/30 p-3">
            <div class="inline-block max-w-[30ch] rounded-md bg-ground/55 p-2.5 backdrop-blur-sm">
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-xs" style={`color:${v.accent}`}>{String(v.id).padStart(2, '0')}</span>
                <span class="font-sans text-sm font-bold text-ink">{v.name}</span>
              </div>
              <code class="mt-1 block font-mono text-[11px] text-accent">{v.law}</code>
              <p class="mt-1.5 font-mono text-[10.5px] leading-snug text-muted">{v.blurb}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
  import { initLab } from '../components/hero-lab/lab.client'
  const canvas = document.getElementById('lab') as HTMLCanvasElement | null
  if (canvas) {
    try { initLab(canvas) } catch (err) { console.error('[HeroLab] init failed:', err) }
  }
</script>
