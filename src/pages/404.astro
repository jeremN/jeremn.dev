---
import Layout from '../layouts/Layout.astro'
import Underline from '../components/site/Underline.astro'
import Doodle from '../components/site/Doodle.astro'
import { withBase } from '../lib/base'

const routes = [
  { label: 'Home', href: '/', hint: 'The landscape and everything below it.' },
  { label: 'Writing', href: '/blog', hint: 'Notes from the workbench.' },
  { label: 'Freelance', href: '/freelance', hint: 'What I do and how to hire me.' },
]
---
<Layout title="Not found · jeremn.dev" noindex hideFooterCta>
  <main class="relative z-10 mx-auto max-w-[1000px] px-6 pb-24 pt-16 sm:pt-24">
    <span class="font-mono text-[11px] uppercase tracking-wider text-accent">404 / Not found</span>

    <div class="mt-6 flex items-start justify-between gap-10">
      <h1 class="max-w-[14ch] font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">
        This page does not <span class="relative inline-block">
          exist.
          <Underline class="absolute -bottom-1 left-0 w-full text-accent" />
        </span>
      </h1>
      <Doodle name="plane" class="hidden h-16 w-32 shrink-0 self-center text-muted sm:block" />
    </div>

    <p class="mt-8 max-w-[42ch] font-sans text-base leading-relaxed text-muted">
      The address is wrong, or the page moved. Here is where to go instead.
    </p>

    {/* GitHub Pages serves this one root 404.html for every missing path, in
        both trees, so the page cannot know the visitor's language. It stays
        English and carries one French line, so a French visitor still reads
        something. `lang="fr"` on that line alone keeps the screen reader on the
        right voice. No hreflang: a page with no address has no twin. */}
    <p lang="fr" class="mt-3 max-w-[42ch] font-sans text-base leading-relaxed text-muted">
      L'adresse est fausse, ou la page a été déplacée. Voici où aller.
    </p>

    <ul data-routes class="mt-16 border-t border-line">
      {routes.map((r) => (
        <li>
          <a
            href={withBase(r.href)}
            class="group grid grid-cols-[1fr] items-baseline gap-y-1 border-b border-line py-5 no-underline sm:grid-cols-[10rem_1fr] sm:gap-y-0"
          >
            <span class="font-mono text-[11px] uppercase tracking-wider text-muted">{r.label}</span>
            <span class="font-sans text-sm text-ink transition-colors group-hover:text-accent">{r.hint}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
