---
// The v1 galaxy hero, preserved off the front door. Design system v2 replaced
// it with the hand-drawn landscape, and 535 lines of working WebGL are worth
// keeping reachable rather than deleting.
//
// The route sits under /hero-lab, so the sitemap filter in astro.config.mjs
// already excludes it. `noindex` covers the crawler.
import Layout from '../../layouts/Layout.astro'
import Eyebrow from '../../components/site/Eyebrow.astro'
import Hero from '../../components/hero/Hero.astro'
import { withBase } from '../../lib/base'
---
<Layout title="Galaxy hero · jeremn.dev" noindex hideFooterCta>
  <Hero />

  <section class="hero-dark relative z-10 flex min-h-[92vh] flex-col justify-center px-6">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ground/85 via-ground/35 to-transparent"></div>
    <div class="relative mx-auto w-full max-w-5xl">
      <Eyebrow class="mb-6 block text-accent">Hero lab · retired v1 hero</Eyebrow>
      <h1 class="font-display text-6xl font-extrabold leading-[0.92] tracking-tight text-ink drop-shadow-[0_2px_40px_rgba(6,5,16,0.9)] sm:text-8xl">
        Jérémie <span class="text-accent">Néhlil</span>
      </h1>
      <p class="mt-6 max-w-[24ch] font-display text-xl text-ink sm:text-2xl">
        I build web apps. <em class="italic text-ink/80">And the tooling around them.</em>
      </p>
    </div>
  </section>

  <section class="relative z-10 bg-ground px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <p class="max-w-[60ch] font-sans text-sm leading-relaxed text-muted">
        This is the hero the site shipped before design system v2. It stays here so the WebGL
        stays runnable. The homepage now uses a hand-drawn landscape.
      </p>
      <a href={withBase('/hero-lab')} class="mt-6 inline-block font-mono text-[11px] uppercase tracking-wider text-accent no-underline">
        ← Back to the physics lab
      </a>
    </div>
  </section>
</Layout>
