---
import Layout from '../layouts/Layout.astro'
import Underline from '../components/site/Underline.astro'
import Doodle from '../components/site/Doodle.astro'
import { profile, links } from '../lib/cv'

// Routes come from cv.ts so /cv, /cv-print and this page cannot disagree.
// Email leads, because it is the one the CTA also uses.
const routes = [
  { label: 'Email', value: profile.email, href: `mailto:${profile.email}`, external: false },
  // Only the platform name is shown. A profile URL carries an encoded slug
  // and reads as noise beside a one-word label.
  ...links.map((l) => ({ label: l.label, value: l.href, href: l.href, external: true })),
]
---
<Layout
  title="Contact · jeremn.dev"
  description="Get in touch with Jérémie Néhlil, senior fullstack JavaScript engineer available for freelance work."
  hideFooterCta
>
  <main class="relative z-10 mx-auto max-w-[1000px] px-6 pb-24 pt-16 sm:pt-24">
    <span class="font-mono text-[11px] uppercase tracking-wider text-accent">05 / Let's talk</span>

    <div class="mt-6 flex items-start justify-between gap-10">
      <h1 class="max-w-[12ch] font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">
        Have something in <span class="relative inline-block">
          mind?
          <Underline class="absolute -bottom-1 left-0 w-full text-accent" />
        </span>
      </h1>
      <Doodle name="plane" class="hidden h-20 w-40 shrink-0 self-center text-ink sm:block" />
    </div>

    <p class="mt-8 max-w-[38ch] font-sans text-base leading-relaxed text-muted">
      Let's talk about what you are building and how I can help.
    </p>

    <a
      data-cta
      href={`mailto:${profile.email}`}
      class="mt-10 inline-flex items-center gap-3 rounded-sm bg-ink px-7 py-4 font-mono text-[11px] uppercase tracking-wider text-ground no-underline transition-opacity hover:opacity-85"
    >
      Let's talk
      <span aria-hidden="true">→</span>
    </a>

    <ul data-routes class="mt-20 border-t border-line">
      {routes.map((r) => (
        <li>
          <a
            href={r.href}
            target={r.external ? '_blank' : undefined}
            rel={r.external ? 'noopener noreferrer' : undefined}
            class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 border-b border-line py-5 no-underline"
          >
              <span class="font-sans text-sm text-ink transition-colors group-hover:text-accent">{r.label}</span>
              <span class="font-mono text-[11px] text-muted">
                {r.external ? <span aria-hidden="true">↗</span> : r.value}
              </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-16 font-mono text-[11px] uppercase tracking-wider text-muted">
      {profile.location} · Remote friendly
    </p>
  </main>
</Layout>
