---
import Layout from '../layouts/Layout.astro'
import Underline from '../components/site/Underline.astro'
import Doodle from '../components/site/Doodle.astro'
import { profile, links } from '../lib/cv'
import { services, howIWork } from '../lib/services'

// Contact routes come from cv.ts, the same way /contact builds them. The two
// pages cannot disagree about where to reach me.
const routes = [
  { label: 'Email', href: `mailto:${profile.email}`, external: false },
  // Only the name is shown. A profile URL carries an encoded slug, and the
  // email address does not need printing next to a link that already sends
  // mail to it.
  ...links.map((l) => ({ label: l.label, href: l.href, external: true })),
]
---
<Layout
  hideFooterCta
  title="Freelance · jeremn.dev"
  description="Hire Jérémie Néhlil, senior JavaScript engineer available for freelance web app work."
>
  <main class="relative z-10 mx-auto max-w-[1000px] px-6 pb-24 pt-16 sm:pt-24">
    <span class="font-mono text-[11px] uppercase tracking-wider text-accent">05 / Freelance</span>

    <div class="mt-6 flex items-start justify-between gap-10">
      <h1 class="max-w-[12ch] font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">
        Available for <span class="relative inline-block">
          your team.
          <Underline class="absolute -bottom-1 left-0 w-full text-accent" />
        </span>
      </h1>
      <Doodle name="nodes" class="hidden h-14 w-20 shrink-0 self-center text-muted sm:block" />
    </div>

    <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <p class="max-w-[42ch] font-sans text-base leading-relaxed text-muted">
        {profile.title}. I build and rebuild web apps, and the tooling around them.
      </p>
      <span class="inline-flex shrink-0 items-center gap-2.5 font-mono text-[11px] uppercase tracking-wider text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Available for freelance work
      </span>
    </div>

    <a
      data-cta
      href={`mailto:${profile.email}`}
      class="mt-10 inline-flex items-center gap-3 rounded-sm bg-ink px-7 py-4 font-mono text-[11px] uppercase tracking-wider text-ground no-underline transition-opacity hover:opacity-85"
    >
      Let's talk
      <span aria-hidden="true">→</span>
    </a>

    <section class="mt-24">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">What I do</h2>
      <ul data-services class="mt-8 border-t border-line">
        {services.map((s) => (
          <li
            data-service
            class="grid grid-cols-[2.5rem_1fr] items-start gap-x-5 border-b border-line py-6 sm:grid-cols-[3.5rem_16rem_1fr] sm:gap-x-10"
          >
            <Doodle name={s.icon} class="h-8 w-8 text-muted" />
            <h3 class="col-start-2 font-sans text-base font-medium text-ink sm:text-lg">{s.title}</h3>
            <p class="col-start-2 mt-2 font-sans text-sm leading-relaxed text-muted sm:col-start-3 sm:mt-0">
              {s.blurb}{s.detail && ` ${s.detail}`}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">How I work</h2>
      <ul data-how class="mt-8 border-t border-line">
        {howIWork.map((h) => (
          <li class="border-b border-line py-5">
            <p class="max-w-[70ch] font-sans text-sm leading-relaxed text-ink">{h}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">Get in touch</h2>
      <ul data-routes class="mt-8 border-t border-line">
        {routes.map((r) => (
          <li>
            <a
              href={r.href}
              target={r.external ? '_blank' : undefined}
              rel={r.external ? 'noopener noreferrer' : undefined}
              class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 border-b border-line py-5 no-underline"
            >
                <span class="font-sans text-sm text-ink transition-colors group-hover:text-accent">{r.label}</span>
                {r.external && <span aria-hidden="true" class="font-mono text-[11px] text-muted">↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-16 font-mono text-[11px] uppercase tracking-wider text-muted">
      {profile.location} · Remote friendly · {profile.languages}
    </p>
  </main>
</Layout>
