---
import Layout from '../layouts/Layout.astro'
import Underline from '../components/site/Underline.astro'
import Doodle from '../components/site/Doodle.astro'
import Tag from '../components/site/Tag.astro'
import { profile, experiences, stack, education, certs, links } from '../lib/cv'
import { withBase } from '../lib/base'
---
<Layout
  title="CV · jeremn.dev"
  description="Selected work, stack, and background of Jérémie Néhlil, senior fullstack JavaScript engineer."
  hideFooterCta
>
  <main class="relative z-10 mx-auto max-w-[1000px] px-6 pb-24 pt-16 sm:pt-24">
    <span class="font-mono text-[11px] uppercase tracking-wider text-accent">04 / Curriculum vitae</span>

    <div class="mt-6 flex items-start justify-between gap-10">
      <h1 class="max-w-[12ch] font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">
        Selected <span class="relative inline-block">
          work.
          <Underline class="absolute -bottom-1 left-0 w-full text-accent" />
        </span>
      </h1>
      <Doodle name="code" class="hidden h-12 w-20 shrink-0 self-center text-muted sm:block" />
    </div>

    <p class="mt-8 max-w-[58ch] font-sans text-base leading-relaxed text-muted sm:text-lg">{profile.lead}</p>

    {/* No email here. The address lives on /contact and /freelance, and a CV
        page that a recruiter may share is the wrong place to publish it. The
        PDF download is the page's one action. */}
    <div class="mt-8">
      <a
        href={withBase('/cv.pdf')}
        class="inline-flex items-center gap-2 rounded-sm border border-line px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted no-underline transition-colors hover:border-accent hover:text-accent"
      >
        Download PDF
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <p class="mt-6 font-mono text-[11px] uppercase tracking-wider text-muted">
      {profile.location} · {profile.languages}
    </p>

    <section class="mt-24">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">Selected work</h2>
      <ul class="mt-8 border-t border-line">
        {experiences.map((p) => (
          <li
            data-experience
            class="grid grid-cols-[1fr] gap-x-10 border-b border-line py-8 sm:grid-cols-[10rem_1fr]"
          >
            <div class="mb-4 sm:mb-0">
              <span class="block font-mono text-[11px] uppercase tracking-wider text-ink">{p.period}</span>
              <span class="mt-1.5 block font-mono text-[10px] uppercase tracking-wider text-accent">{p.role}</span>
              <span class="mt-1 block font-mono text-[10px] uppercase tracking-wider text-muted">
                {p.kind === 'agency' ? 'Agency / ESN' : 'Freelance'}
              </span>
              {p.location && (
                <span class="mt-1 block font-mono text-[10px] uppercase tracking-wider text-muted">{p.location}</span>
              )}
            </div>
            <div>
              <h3 class="font-display text-2xl font-medium leading-snug text-ink sm:text-3xl">{p.company}</h3>
              <p class="mt-3 max-w-[62ch] font-sans text-sm leading-relaxed text-muted">{p.blurb}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {p.stack.map((s) => <Tag>{s}</Tag>)}
              </div>
              {p.missions && (
                <ul class="mt-7 space-y-6 border-l border-line pl-6">
                  {p.missions.map((m) => (
                    <li data-mission>
                      <div class="flex flex-wrap items-baseline gap-x-3">
                        <h4 class="font-display text-lg font-medium text-ink">{m.client}</h4>
                        <span class="font-mono text-[10px] uppercase tracking-wider text-muted">{m.period}</span>
                      </div>
                      <p class="mt-2 max-w-[58ch] font-sans text-sm leading-relaxed text-muted">{m.blurb}</p>
                      {m.note && <p class="mt-2 font-sans text-xs italic text-muted">{m.note}</p>}
                      <div class="mt-3 flex flex-wrap gap-2">
                        {m.stack.map((s) => <Tag>{s}</Tag>)}
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">Stack</h2>
      <dl class="mt-8 border-t border-line">
        {stack.map((group) => (
          <div class="grid grid-cols-[1fr] gap-x-10 gap-y-3 border-b border-line py-5 sm:grid-cols-[10rem_1fr] sm:gap-y-0">
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">{group.label}</dt>
            <dd class="flex flex-wrap gap-2">
              {group.items.map((s) => <Tag>{s}</Tag>)}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-20">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">Education and certifications</h2>
      <dl class="mt-8 border-t border-line">
        {education.map((e) => (
          <div class="grid grid-cols-[1fr] gap-x-10 gap-y-1 border-b border-line py-5 sm:grid-cols-[10rem_1fr] sm:gap-y-0">
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">{e.year}</dt>
            <dd class="font-sans text-sm text-muted">
              <span class="text-ink">{e.title}</span> · {e.detail}
            </dd>
          </div>
        ))}
        <div class="grid grid-cols-[1fr] gap-x-10 gap-y-1 border-b border-line py-5 sm:grid-cols-[10rem_1fr] sm:gap-y-0">
          <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">Certs</dt>
          <dd class="font-sans text-sm text-muted">{certs.join(' · ')}</dd>
        </div>
      </dl>
    </section>

    <section class="mt-20">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">Full profile</h2>
      <ul class="mt-8 border-t border-line">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 border-b border-line py-5 no-underline"
            >
              <span class="font-sans text-sm text-ink transition-colors group-hover:text-accent">{l.label}</span>
              <span aria-hidden="true" class="font-mono text-[11px] text-muted">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
