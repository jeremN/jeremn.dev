---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { readingTime } from '../../lib/reading-time'
import { withBase } from '../../lib/base'
import Underline from '../../components/site/Underline.astro'
import Doodle from '../../components/site/Doodle.astro'
import { illustrationForSlug, mobileCropOffsetForSlug } from '../../lib/article-illustrations'

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV)).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  )
  // Newest-first, so index i has its older neighbour at i+1. Only the older one
  // is passed: the template offers a single onward link, never a back one.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, older: posts[i + 1] ?? null },
  }))
}

const { post, older } = Astro.props
const { Content, headings } = await render(post)
const date = post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
const category = post.data.tags.join(' / ').toUpperCase()
const readTime = readingTime(post.body)
// "On this page" rail — only worth showing once a post has real structure.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const showToc = toc.length >= 2
// Curated, not exhaustive: only some posts have a drawn illustration yet, and
// there is no reasonable fallback for the ones that don't (see the lib for why).
const illustration = illustrationForSlug(post.id)
// Most posts' mobile crop uses the shared -64.61% default (see the Doodle
// below); a few need their own horizontal window so their subject doesn't
// land outside it (see the lib for why, and task-2-report.md for the math).
const mobileCropOffset = mobileCropOffsetForSlug(post.id)
---
<Layout title={`${post.data.title} · jeremn.dev`} description={post.data.summary}>
  <main
    class:list={[
      'relative z-10 mx-auto px-6 pb-24 pt-2',
      showToc
        ? 'max-w-[68ch] lg:max-w-none lg:grid lg:grid-cols-[13rem_minmax(0,68ch)] lg:justify-center lg:gap-x-20'
        : 'max-w-[68ch]',
    ]}
  >
    {showToc && (
      <aside class="hidden lg:block">
        <nav class="sticky top-24" aria-label="On this page">
          <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-muted">On this page</span>
          <ul class="border-l border-line">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc={h.slug}
                  class:list={[
                    'toc-link -ml-px block border-l border-transparent py-1 font-mono text-xs leading-snug text-muted transition-colors hover:text-ink',
                    h.depth === 3 ? 'pl-7' : 'pl-4',
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}

    <div>
      <a data-back href={withBase('/blog')} class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-accent no-underline transition-opacity hover:opacity-70">
        ← All notes
      </a>

      <div class="mt-10 flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
        <div class="min-w-0">
          <p class="font-mono text-[11px] uppercase tracking-wider text-muted">
            {date}{category && ` · ${category}`}
          </p>

          <h1 class="mt-4 max-w-[18ch] font-display text-4xl font-medium leading-[1.1] tracking-tight text-ink sm:text-5xl">
            <span class="relative inline-block">
              {post.data.title}
              <Underline class="absolute -bottom-2 left-0 w-full text-accent" />
            </span>
          </h1>

          {post.data.summary && (
            <p class="mt-8 max-w-[44ch] font-sans text-base leading-relaxed text-muted">{post.data.summary}</p>
          )}

          <p class="mt-6 font-mono text-[11px] uppercase tracking-wider text-muted">{readTime}</p>
        </div>

        {/* Smaller than Home's hero doodle on purpose: the article column
            tops out at 68ch (this page's typographic measure), far narrower
            than Home's 1440px section, so a hero-sized mark here would crush
            the title column into single-word-per-line wrapping. Sized to
            preserve the source's 984x540 (~1.82:1) aspect ratio. */}
        {illustration && (
          <Doodle name={illustration} class="hidden shrink-0 text-ink lg:block lg:h-[9.5rem] lg:w-[17.3rem]" />
        )}

        {/* Same cropped-viewport idiom as Home's hero and Writing's header: an
            overflow-hidden box at the mobile slot's own aspect ratio, with the
            (landscape, 984x540) illustration scaled up to fill it height-first,
            so the visible slice has no letterboxing. The horizontal offset
            defaults to dead-center (-64.61%) but is overridden per slug where
            that center-crop misses the subject — see mobileCropOffsetForSlug. */}
        {illustration && (
          <div class="relative aspect-[318/400] overflow-hidden lg:hidden">
            <Doodle
              name={illustration}
              class="absolute top-0 h-full w-[229.21%] text-ink"
              style={`left: ${mobileCropOffset}`}
            />
          </div>
        )}
      </div>

    <article class="prose mt-10 max-w-none prose-pre:rounded-lg prose-pre:border prose-pre:border-line">
      <Content />
    </article>

    {/* The comp offers one onward article, not two. `older` is the right one:
        a reader who finished the newest post has nowhere newer to go, and
        offering `newer` on an older post sends them backwards through a series. */}
    {older && (
      <nav data-keep-reading class="mt-24 border-t border-line pt-10">
        <span class="font-mono text-[11px] uppercase tracking-wider text-accent">Keep reading</span>
        <a href={withBase(`/blog/${older.id}`)} class="group mt-4 flex items-end justify-between gap-8 no-underline">
          <span class="max-w-[20ch] font-display text-3xl font-medium leading-tight text-ink transition-colors group-hover:text-accent sm:text-4xl">
            {older.data.title}
          </span>
          <span aria-hidden="true" class="pb-2 text-2xl text-ink transition-colors duration-200 group-hover:text-accent">→</span>
        </a>
      </nav>
    )}
    </div>
  </main>
</Layout>

<script>
  // Progressive enhancement for the article reading view: a header bar
  // (language label + copy button) on each code block, and hover-revealed
  // permalinks on headings. Heading ids already exist server-side, so deep
  // links work without this; the visible # is just an affordance.
  const article = document.querySelector('article.prose')
  if (article) {
    article.querySelectorAll('pre').forEach((pre) => {
      const figure = document.createElement('figure')
      figure.className = 'code-block'
      const head = document.createElement('div')
      head.className = 'code-block__head'

      const label = document.createElement('span')
      label.className = 'code-block__lang'
      label.textContent = (pre.dataset.language || '').toUpperCase()

      const copy = document.createElement('button')
      copy.type = 'button'
      copy.className = 'code-block__copy'
      copy.textContent = 'Copy'
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText)
          copy.textContent = 'Copied'
          copy.classList.add('is-copied')
        } catch {
          copy.textContent = 'Failed'
        }
        setTimeout(() => {
          copy.textContent = 'Copy'
          copy.classList.remove('is-copied')
        }, 1600)
      })

      head.append(label, copy)
      pre.replaceWith(figure)
      figure.append(head, pre)
    })

    article.querySelectorAll('h2[id], h3[id]').forEach((heading) => {
      const anchor = document.createElement('a')
      anchor.className = 'heading-anchor'
      anchor.href = '#' + heading.id
      anchor.setAttribute('aria-label', 'Link to this section')
      anchor.textContent = '#'
      heading.append(anchor)
    })

    // Table-of-contents scroll-spy: mark the section currently in view.
    const tocLinks = new Map(
      [...document.querySelectorAll<HTMLElement>('[data-toc]')].map((a) => [a.dataset.toc, a]),
    )
    if (tocLinks.size) {
      const headings = [...article.querySelectorAll('h2[id], h3[id]')]
      const visible = new Set<Element>()
      let activeId: string | null = null
      const setActive = (id: string) => {
        if (id === activeId) return
        if (activeId) tocLinks.get(activeId)?.classList.remove('is-active')
        activeId = id
        tocLinks.get(id)?.classList.add('is-active')
      }
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) visible.add(e.target)
            else visible.delete(e.target)
          }
          const top = headings.find((h) => visible.has(h))
          if (top) setActive(top.id)
        },
        { rootMargin: '0px 0px -75% 0px' },
      )
      headings.forEach((h) => spy.observe(h))
    }
  }
</script>
