---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import PostRow from '../../components/site/PostRow.astro'
import Underline from '../../components/site/Underline.astro'
import Doodle from '../../components/site/Doodle.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
)

// Tags actually in use, alphabetical. Deriving them from the collection means
// a new tag appears in the filter the moment a post uses it.
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) => a.localeCompare(b))
---
<Layout
  title="Writing · jeremn.dev"
  description="Essays and notes by Jérémie Néhlil on web development, performance, and the tooling around it."
>
  {/* The page grid is 1440, but the reading list keeps its own narrower column
      so the metadata stays beside the title instead of drifting to the screen
      edge on a wide monitor. The shell above and below still spans 1440. */}
  <main class="relative z-10 mx-auto max-w-[1000px] px-6 pb-24 pt-16 sm:pt-24">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-16">
      <div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-accent">02 / Notes from the workbench</span>

        <h1 class="mt-8 max-w-[14ch] font-display text-5xl font-medium leading-[0.98] tracking-tight text-ink sm:mt-12 sm:text-7xl lg:text-8xl">
          Notes from the <span class="relative inline-block italic">
            workbench.
            <Underline class="absolute -bottom-1 left-0 w-full text-accent" />
          </span>
        </h1>

        <p class="mt-2.5 max-w-[42ch] font-sans text-base leading-relaxed text-muted sm:mt-28">
          Thoughts on software, AI, tools and things I learn along the way.
        </p>
      </div>

      <Doodle name="xiaohei-writing-header" class="hidden shrink-0 text-ink lg:block lg:h-[25rem] lg:w-[19.875rem]" />

      <Doodle
        name="xiaohei-writing-header"
        class="mx-auto aspect-[318/400] w-full max-w-[280px] text-ink lg:hidden"
      />
    </div>

    {tags.length > 0 && (
      <div class="mt-16 flex flex-wrap gap-x-5 gap-y-3 border-b border-line pb-8 sm:mt-24">
        <button type="button" data-filter="*" aria-pressed="true" class="filter-tab">All</button>
        {tags.map((t) => (
          <button type="button" data-filter={t} aria-pressed="false" class="filter-tab">{t}</button>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <div class="mt-16 border-t border-line pt-14">
        <p class="max-w-[26ch] font-display text-3xl leading-tight text-ink sm:text-4xl">
          Nothing published yet.
        </p>
        <p class="mt-5 font-mono text-xs text-muted">The first post is in progress.</p>
      </div>
    ) : (
      <ul class="mt-0">
        {posts.map((p) => (
          <li data-tags={p.data.tags.join(' ')}>
            <PostRow slug={p.id} title={p.data.title} summary={p.data.summary} tags={p.data.tags} publishedAt={p.data.publishedAt} body={p.body} />
          </li>
        ))}
      </ul>
    )}

    {/* The validated mobile design ends the page at "Older notes" — no
        closing illustration below lg, matching the desktop-only footer mark
        on Home. */}
    <Doodle name="xiaohei-writing-footer" class="mt-20 hidden aspect-[992/339] w-full text-ink lg:block" />
  </main>
</Layout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')]
  const items = [...document.querySelectorAll<HTMLLIElement>('li[data-tags]')]

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const want = tab.dataset.filter!
      for (const other of tabs) other.setAttribute('aria-pressed', String(other === tab))
      for (const item of items) {
        const tags = (item.dataset.tags ?? '').split(' ').filter(Boolean)
        item.hidden = want !== '*' && !tags.includes(want)
      }
    })
  }
</script>
