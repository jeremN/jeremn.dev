---
import Layout from '../layouts/Layout.astro'
import Underline from '../components/site/Underline.astro'
import Doodle from '../components/site/Doodle.astro'
import { profile } from '../lib/cv'

// This page's own copy, distinct from lib/services.ts (Home's teaser grid and
// /freelance's fuller list): the validated comp writes each line as a short,
// parallel offer statement, a different voice than the existing blurbs.
const devItems = [
  { icon: 'svc-icon-fullstack', title: 'Full-stack development', copy: 'Interface to deployment.' },
  { icon: 'svc-icon-frontend', title: 'Frontend development', copy: 'Accessible product interfaces.' },
  { icon: 'svc-icon-backend', title: 'Backend & APIs', copy: 'Stable services and boundaries.' },
  { icon: 'svc-icon-performance', title: 'Performance & audits', copy: 'Evidence, risks, and next steps.' },
  { icon: 'svc-icon-automation', title: 'Automation & tooling', copy: 'Scripts, CI, and internal tools.' },
  { icon: 'svc-icon-ai-integration', title: 'AI integration', copy: 'Useful features with controls.' },
] as const

const aiItems = [
  { icon: 'svc-icon-agent-setup', title: 'Agent setup', copy: 'A governed agent with the correct tools and checks.' },
  {
    icon: 'svc-icon-workflow-automation',
    title: 'Workflow automation',
    copy: 'A repeatable workflow across the tools you already use.',
  },
  {
    icon: 'svc-icon-ai-tool-integration',
    title: 'AI tool integration',
    copy: 'A product feature with retrieval and human review.',
  },
] as const

const quoteHref = `mailto:${profile.email}?subject=${encodeURIComponent('Project quote')}`
---
<Layout
  hideFooterCta
  title="Services · jeremn.dev"
  description="Freelance engineering for product teams, plus scoped AI systems for repetitive work."
>
  <main class="relative z-10 mx-auto max-w-[1000px] px-6 pb-24 pt-16 sm:pt-24">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
      <div class="min-w-0">
        <span class="font-mono text-[11px] uppercase tracking-wider text-accent">06 / Services</span>

        <h1 class="mt-6 max-w-[15ch] font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">
          Useful systems, <span class="relative inline-block">
            <em class="italic">built with intent.</em>
            <Underline class="absolute -bottom-1 left-0 w-full text-accent" />
          </span>
        </h1>

        <p class="mt-8 max-w-[46ch] font-sans text-base leading-relaxed text-muted">
          Freelance engineering for product teams, plus scoped AI systems for repetitive work.
        </p>
      </div>

      <Doodle name="xiaohei-services-hero" class="hidden shrink-0 text-ink lg:block lg:h-[12.4rem] lg:w-[22rem]" />
    </div>

    <Doodle name="xiaohei-services-hero" class="mx-auto mt-10 aspect-[360/203] w-full max-w-[360px] text-ink lg:hidden" />

    <section class="mt-16 border-t border-line pt-8 sm:mt-20">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">{'01 / Development'}</h2>
      <h3 class="mt-4 max-w-[26ch] font-display text-2xl font-medium leading-snug text-ink sm:text-3xl">
        Six ways I can support a product team.
      </h3>
      <p class="mt-3 max-w-[50ch] font-sans text-sm leading-relaxed text-muted">
        Choose a focused audit, a delivery scope, or hands-on engineering support.
      </p>

      <ul class="mt-10 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2">
        {devItems.map((s) => (
          <li class="border-t border-line pt-5">
            <Doodle name={s.icon} class="h-8 aspect-[49/34] text-ink" />
            <h4 class="mt-3 font-sans text-base font-medium text-ink">{s.title}</h4>
            <p class="mt-2 font-sans text-sm leading-relaxed text-muted">{s.copy}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20 grid grid-cols-1 gap-10 border-t border-line pt-8 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <div>
        <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">{'02 / AI & automation'}</h2>
        <h3 class="mt-4 max-w-[24ch] font-display text-2xl font-medium leading-snug text-ink sm:text-3xl">
          One scoped system. One visible outcome.
        </h3>
        <p class="mt-3 max-w-[42ch] font-sans text-sm leading-relaxed text-muted">
          The offer stays separate from open-ended freelance development.
        </p>
      </div>

      <ul class="border-t border-line">
        {aiItems.map((item) => (
          <li class="grid grid-cols-[2.9rem_1fr] items-center gap-x-5 border-b border-line py-5">
            <Doodle name={item.icon} class="h-8 aspect-[49/34] text-ink" />
            <div>
              <h4 class="font-sans text-base font-medium text-ink">{item.title}</h4>
              <p class="mt-1 font-sans text-sm leading-relaxed text-muted">{item.copy}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-20 flex flex-col gap-8 rounded-sm bg-ink px-8 py-10 sm:flex-row sm:items-center sm:justify-between sm:gap-12 sm:px-12">
      <div class="max-w-[36ch]">
        <span class="font-mono text-[11px] uppercase tracking-wider text-ground/70">Ready when you are</span>
        <p class="mt-3 font-display text-2xl font-medium leading-snug text-ground sm:text-3xl">
          Bring the constraint. I will help define the work.
        </p>
      </div>
      <a
        data-quote-cta
        href={quoteHref}
        class="inline-flex shrink-0 items-center gap-3 rounded-sm bg-ground px-7 py-4 font-mono text-[11px] uppercase tracking-wider text-ink no-underline transition-opacity hover:opacity-85"
      >
        Request a quote
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </main>
</Layout>
