---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import PostRow from '../site/PostRow.astro'
import Underline from '../site/Underline.astro'
import Doodle from '../site/Doodle.astro'
import { getCopy, type Locale } from '../../i18n'
import { isVisible } from '../../lib/posts'

interface Props { lang: Locale }
const { lang } = Astro.props
const t = getCopy(lang, 'blog')

const posts = (
  await getCollection('blog', (p) => p.data.lang === lang && isVisible(p))
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())

// Tags actually in use, alphabetical. Deriving them from the collection means
// a new tag appears in the filter the moment a post uses it.
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) => a.localeCompare(b))
---
<Layout lang={lang} title={t.title} description={t.description}>
  {/* The page grid is 1440, but the reading list keeps its own narrower column
      so the metadata stays beside the title instead of drifting to the screen
      edge on a wide monitor. The shell above and below still spans 1440. */}
  <main class="relative z-10 mx-auto max-w-[1000px] px-6 pb-24 pt-16 sm:pt-24">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
      <div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-accent">{t.eyebrow}</span>

        <h1 class="mt-6 max-w-[14ch] font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">
          {/* No newline between the two halves: the French headline joins them
              on an apostrophe, and a collapsed line break would render
              "Notes de l' établi." */}
          {t.headlineBefore}<span class="relative inline-block italic">{t.headlineEmphasis}
            <Underline class="absolute -bottom-1 left-0 w-full text-accent" />
          </span>
        </h1>

        <p class="mt-8 max-w-[42ch] font-sans text-base leading-relaxed text-muted">
          {t.lead}
        </p>
      </div>

      <Doodle name="xiaohei-writing-header" class="hidden shrink-0 text-ink lg:block lg:h-[25rem] lg:w-[19.875rem]" />

      <Doodle
        name="xiaohei-writing-header"
        class="mx-auto aspect-[318/400] w-full max-w-[280px] text-ink lg:hidden"
      />
    </div>

    {tags.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-x-5 gap-y-3 border-b border-line pb-8 sm:mt-24">
        <button type="button" data-filter="*" aria-pressed="true" class="filter-tab">{t.filterAll}</button>
        {tags.map((tag) => (
          <button type="button" data-filter={tag} aria-pressed="false" class="filter-tab">{tag}</button>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <div class="mt-16 border-t border-line pt-14">
        <p class="max-w-[26ch] font-display text-3xl leading-tight text-ink sm:text-4xl">
          {t.emptyTitle}
        </p>
        <p class="mt-5 font-mono text-xs text-muted">{t.emptyBody}</p>
      </div>
    ) : (
      <ul class="mt-0">
        {posts.map((p) => (
          <li data-tags={p.data.tags.join(' ')}>
            <PostRow slug={p.id} title={p.data.title} summary={p.data.summary} tags={p.data.tags} publishedAt={p.data.publishedAt} body={p.body} lang={lang} />
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')]
  const items = [...document.querySelectorAll<HTMLLIElement>('li[data-tags]')]

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const want = tab.dataset.filter!
      for (const other of tabs) other.setAttribute('aria-pressed', String(other === tab))
      for (const item of items) {
        const tags = (item.dataset.tags ?? '').split(' ').filter(Boolean)
        item.hidden = want !== '*' && !tags.includes(want)
      }
    })
  }
</script>
