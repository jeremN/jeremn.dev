---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Underline from '../site/Underline.astro'
import Doodle from '../site/Doodle.astro'
import PostRow from '../site/PostRow.astro'
import { profile } from '../../lib/cv'
import { getServices } from '../../lib/services'
import { withBase } from '../../lib/base'
import { getCopy, type Locale } from '../../i18n'

interface Props { lang: Locale }
const { lang } = Astro.props
const t = getCopy(lang, 'home')
const services = getServices(lang)

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3)

// The validated design pairs each homepage teaser row with one of the three
// Xiaohei article marks in a fixed code/lock/cubes sequence, not by tag: the
// mock's own per-row assignment does not match what `markForTags` computes
// for either the posts shown here today or the posts the mock was drawn
// against, so this stays a fixed sequence rather than a tag mapping. See the
// task report for the full comparison.
const HOME_NOTE_MARKS = ['xiaohei-mark-code', 'xiaohei-mark-lock', 'xiaohei-mark-cubes'] as const
---
<Layout lang={lang} title={t.title} description={t.description} hideFooterCta>
  <main class="relative z-10">
    <section data-hero class="mx-auto max-w-[1000px] px-6 pt-16 sm:pt-24">
      <div class="flex flex-col gap-12 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
        <div class="min-w-0">
          <span class="inline-flex items-center rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-accent">
            {t.eyebrow}
          </span>

          <h1 class="mt-6 max-w-[16ch] font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">
            {t.headlineBefore}<span class="relative inline-block">
              <em class="italic">{t.headlineEmphasis}</em>
              <Underline class="absolute -bottom-2 left-0 w-full text-accent" />
            </span>
          </h1>

          <div class="mt-8 flex flex-col gap-8">
            <p class="max-w-[42ch] font-sans text-base leading-relaxed text-muted">
              {profile.title}{t.leadTail}
            </p>

            <div class="flex flex-col items-start gap-5">
              <span class="inline-flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-wider text-muted">
                <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                {t.availability}
              </span>
              <a
                data-hero-cta
                href={withBase('/contact')}
                class="inline-flex items-center gap-3 rounded-sm bg-ink px-7 py-4 font-mono text-[11px] uppercase tracking-wider text-ground no-underline transition-opacity hover:opacity-85"
              >
                {t.cta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>

        <Doodle name="xiaohei-hero" class="hidden shrink-0 text-ink lg:block lg:h-[28rem] lg:w-[26rem]" />

        <Doodle
          name="xiaohei-hero"
          class="mx-auto aspect-[524/560] w-full max-w-[340px] text-ink lg:hidden"
        />
      </div>
    </section>

    <section data-services class="mx-auto max-w-[1000px] px-6 pt-8 sm:pt-32">
      <h2 class="border-t border-line pt-8 font-mono text-[11px] uppercase tracking-wider text-accent">{t.servicesHeading}</h2>
      <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-6 lg:gap-x-8">
        {services.map((s) => (
          <li data-service>
            <Doodle name={s.icon} class="h-10 w-10 text-ink" />
            <h3 class="mt-5 font-sans text-base font-medium text-ink">{s.title}</h3>
            <p class="mt-2 max-w-[34ch] font-sans text-sm leading-relaxed text-muted">{s.blurb}</p>
          </li>
        ))}
      </ul>
    </section>

    <section data-writing class="mx-auto max-w-[1000px] px-6 pt-24 sm:pt-32">
      <div class="flex items-baseline justify-between gap-6 border-t border-line pt-8">
        <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">{t.writingHeading}</h2>
        <a href={withBase('/blog')} class="font-mono text-[11px] uppercase tracking-wider text-muted no-underline transition-colors hover:text-accent">
          {t.writingAllNotes}
        </a>
      </div>

      {posts.length === 0 ? (
        <p class="mt-10 max-w-[26ch] font-display text-2xl leading-tight text-ink">
          {t.writingEmpty}
        </p>
      ) : (
        <ul class="mt-10">
          {posts.map((p, i) => (
            <li>
              <PostRow
                slug={p.id}
                title={p.data.title}
                tags={p.data.tags}
                publishedAt={p.data.publishedAt}
                body={p.body}
                variant="teaser"
                mark={HOME_NOTE_MARKS[i]}
              />
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mx-auto max-w-[1000px] px-6 pb-24 pt-24 sm:pt-32">
      <div class="grid grid-cols-1 gap-16 border-t border-line pt-8 lg:grid-cols-2 lg:gap-0 lg:divide-x lg:divide-line">
        <div data-about class="lg:pr-10">
          <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">{t.aboutHeading}</h2>
          <div class="mt-6 flex items-center justify-between gap-6">
            <p class="max-w-[26ch] font-sans text-sm leading-relaxed text-muted">
              {t.aboutBlurb}
            </p>
            <Doodle name="xiaohei-about" class="h-20 w-20 shrink-0 text-ink sm:h-24 sm:w-24" />
          </div>
          <a
            href={withBase('/about')}
            class="mt-6 inline-block font-mono text-[11px] uppercase tracking-wider text-accent no-underline transition-opacity hover:opacity-70"
          >
            {t.aboutLink}
          </a>
        </div>

        <div data-contact class="lg:pl-10">
          <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">{t.contactHeading}</h2>
          <div class="mt-6 flex items-center justify-between gap-6">
            <div>
              <p class="max-w-[26ch] font-sans text-sm leading-relaxed text-muted">
                {t.contactBlurb}
              </p>
              <a
                href={withBase('/contact')}
                class="mt-6 inline-flex items-center gap-3 rounded-sm bg-ink px-7 py-4 font-mono text-[11px] uppercase tracking-wider text-ground no-underline transition-opacity hover:opacity-85"
              >
                {t.cta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
            <Doodle name="xiaohei-contact" class="h-16 w-24 shrink-0 text-ink sm:h-20 sm:w-32" />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
