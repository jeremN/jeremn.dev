---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Underline from '../site/Underline.astro'
import Doodle from '../site/Doodle.astro'
import Arrow from '../site/Arrow.astro'
import PostRow from '../site/PostRow.astro'
import { getProfile } from '../../lib/cv'
import { getServices } from '../../lib/services'
import { withBase, pageUrl } from '../../lib/base'
import { getCopy, ROUTE_MAP, type Locale } from '../../i18n'
import { websiteLd } from '../../lib/structured-data'

interface Props { lang: Locale }
const { lang } = Astro.props
const t = getCopy(lang, 'home')
const services = getServices(lang)
const profile = getProfile(lang)

// Not `isVisible`: the teaser hides drafts even in dev, unlike the index and
// the article routes. Three curated rows have no room for a half-written post.
// This predates the bilingual work — `main` has the same test.
const posts = (await getCollection('blog', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3)

// Every in-page link, read from ROUTE_MAP so the French routes keep one source
// of truth. The rows derive their own prefix from `lang` inside PostRow; these
// three are the section header's link and the two CTAs.
const href = (route: string) => (lang === 'fr' ? (ROUTE_MAP[route] ?? route) : route)
const blogIndex = href('/blog')
const contact = href('/contact')
const about = href('/about')

// The validated design pairs each homepage teaser row with one of the three
// Xiaohei article marks in a fixed code/lock/cubes sequence, not by tag: the
// mock's own per-row assignment does not match what `markForTags` computes
// for either the posts shown here today or the posts the mock was drawn
// against, so this stays a fixed sequence rather than a tag mapping. See the
// task report for the full comparison.
const HOME_NOTE_MARKS = ['xiaohei-mark-code', 'xiaohei-mark-lock', 'xiaohei-mark-cubes'] as const
---
<Layout lang={lang} title={t.title} description={t.description} jsonLd={websiteLd(lang, pageUrl, t.description)}>
  <main class="relative z-10">
    <section data-hero class="mx-auto max-w-[1000px] px-6 pt-16 sm:pt-24">
      <div class="flex flex-col gap-12 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
        <div class="min-w-0">
          <span class="inline-flex items-center rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-label uppercase tracking-wider text-accent">
            {t.eyebrow}
          </span>

          <h1 class="mt-6 max-w-[16ch] font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">
            {t.headlineBefore}<span class="relative inline-block">
              <em class="italic">{t.headlineEmphasis}</em>
              <Underline class="absolute -bottom-2 left-0 w-full text-accent" />
            </span>
          </h1>

          <div class="mt-8 flex flex-col gap-8">
            <p class="max-w-[42ch] font-sans text-base leading-relaxed text-muted">
              {profile.title}{t.leadTail}
            </p>

            <div class="flex flex-col items-start gap-5">
              <span class="inline-flex items-center gap-2.5 font-mono text-label uppercase tracking-wider text-muted">
                <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                {t.availability}
              </span>
              <a
                data-hero-cta
                href={withBase(contact)}
                class="button-primary w-full sm:w-auto"
              >
                {t.cta}
                <Arrow />
              </a>
            </div>
          </div>
        </div>

        <Doodle name="xiaohei-hero" class="hidden shrink-0 text-ink lg:block lg:h-[28rem] lg:w-[26rem]" />

        <Doodle
          name="xiaohei-hero"
          class="mx-auto aspect-[524/560] w-full max-w-[340px] text-ink lg:hidden"
        />
      </div>
    </section>

    <section data-services class="mx-auto max-w-[1000px] px-6 pt-8 sm:pt-32">
      <h2 class="border-t border-line pt-8 font-mono text-label uppercase tracking-wider text-accent">{t.servicesHeading}</h2>
      <ul class="mt-10 grid grid-cols-1 min-[360px]:grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4 lg:gap-x-8">
        {services.map((s) => (
          <li data-service class="min-w-0 [overflow-wrap:anywhere]">
            <Doodle name={s.icon} class="h-10 w-10 text-ink" />
            <h3 class="mt-5 font-sans text-base font-medium lg:font-display lg:text-lg text-ink">{s.title}</h3>
            <p class="mt-2 max-w-[34ch] font-sans text-[13px] leading-[18px] lg:text-base lg:leading-6 text-muted">{s.blurb}</p>
          </li>
        ))}
      </ul>
    </section>

    <section data-writing class="mx-auto max-w-[1000px] px-6 pt-24 sm:pt-32">
      <div class="flex items-baseline justify-between gap-6 border-t border-line pt-8">
        <h2 class="font-mono text-label uppercase tracking-wider text-accent">{t.writingHeading}</h2>
        <a href={withBase(blogIndex)} class="inline-flex min-h-touch items-center gap-2 font-mono text-label uppercase tracking-wider text-muted no-underline transition-colors hover:text-accent">
          {t.writingAllNotes}
          <Arrow />
        </a>
      </div>

      {/* Mobile only: the about section's border-top follows straight after
          the list, so the last row's own bottom rule would double it. */}
      {posts.length === 0 ? (
        <p class="mt-10 max-w-[26ch] font-display text-2xl leading-tight text-ink">
          {t.writingEmpty}
        </p>
      ) : (
        <ul class="mt-10 max-sm:[&>li:last-child>.post-row]:border-b-0">
          {posts.map((p, i) => (
            <li>
              <PostRow
                slug={p.id}
                title={p.data.title}
                tags={p.data.tags}
                publishedAt={p.data.publishedAt}
                body={p.body}
                variant="teaser"
                lang={lang}
                mark={HOME_NOTE_MARKS[i]}
              />
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mx-auto max-w-[1000px] px-6 pb-24 pt-8 sm:pt-32">
      <div class="grid grid-cols-1 gap-16 border-t border-line pt-8 lg:grid-cols-2 lg:gap-0 lg:divide-x lg:divide-line">
        {/* Each column is a two-track grid: copy on the left, the mascot on
            the right standing on the column's baseline. On mobile the about
            mascot shares the link's row; the contact one sits right-aligned
            above the full-width button. Side by side from 40rem. */}
        <div data-about class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-6 lg:pr-10">
          <h2 class="col-span-2 font-mono text-label uppercase tracking-wider text-accent">{t.aboutHeading}</h2>
          <p class="col-span-2 mt-6 max-w-[26ch] font-display text-[22px] leading-[29px] text-muted sm:col-span-1 lg:font-sans lg:text-sm lg:leading-[21px]">
            {t.aboutBlurb}
          </p>
          <a
            href={withBase(about)}
            class="text-cta col-start-1 row-start-3 mt-6 inline-flex min-h-touch items-center gap-2 self-end font-mono text-label uppercase tracking-wider text-accent lg:font-display lg:text-[15px] lg:normal-case lg:tracking-normal no-underline"
          >
            {t.aboutLink}
            {/* Newsreader sits its capitals higher in the line box than Geist. */}
            <Arrow class="lg:-translate-y-[0.12em]" />
          </a>
          <Doodle
            name="xiaohei-about"
            class="col-start-2 row-start-3 mt-4 h-28 w-28 self-end text-ink sm:row-span-2 sm:row-start-2 sm:mt-6 sm:h-40 sm:w-40"
          />
        </div>

        <div data-contact class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-6 lg:pl-10">
          <h2 class="col-span-2 font-mono text-label uppercase tracking-wider text-accent">{t.contactHeading}</h2>
          <p class="col-span-2 mt-6 max-w-[26ch] font-display text-[26px] font-bold leading-[30px] text-muted sm:col-span-1 lg:font-sans lg:text-base lg:font-normal lg:leading-6">
            {t.contactBlurb}
          </p>
          <Doodle
            name="xiaohei-contact"
            class="col-span-2 row-start-3 -mt-2 h-28 w-28 justify-self-end text-ink sm:col-span-1 sm:col-start-2 sm:row-span-2 sm:row-start-2 sm:mt-6 sm:h-40 sm:w-40 sm:self-end"
          />
          <a
            href={withBase(contact)}
            class="button-primary col-span-2 row-start-4 mt-4 w-full sm:col-span-1 sm:row-start-3 sm:mt-6 sm:w-auto sm:justify-self-start sm:self-end"
          >
            {t.cta}
            <Arrow />
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
