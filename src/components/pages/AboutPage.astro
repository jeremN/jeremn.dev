---
import Layout from '../../layouts/Layout.astro'
import Underline from '../site/Underline.astro'
import Doodle from '../site/Doodle.astro'
import { getProfile, stack } from '../../lib/cv'
import { withBase, pageUrl } from '../../lib/base'
import { getCopy, type Locale } from '../../i18n'
import { aboutLd } from '../../lib/structured-data'

interface Props { lang: Locale }
const { lang } = Astro.props
const t = getCopy(lang, 'about')
const profile = getProfile(lang)

// The tools list is generated from cv.ts instead, because a second
// hand-typed stack would drift from /cv the first time either changes.
const tools = stack.flatMap((group) => group.items)
const route = lang === 'fr' ? '/fr/a-propos' : '/about'
---
<Layout lang={lang} title={t.title} description={t.description} jsonLd={aboutLd(lang, pageUrl, route)}>
  <main class="relative z-10 mx-auto max-w-[1000px] px-6 pb-24 pt-16 sm:pt-24">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
      <div class="min-w-0">
        <span class="font-mono text-[11px] uppercase tracking-wider text-accent">{t.eyebrow}</span>

        <h1 class="mt-6 max-w-[13ch] font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">
          {t.headlineBefore}<span class="relative inline-block">
            {t.headlineEmphasis}
            <Underline class="absolute -bottom-1 left-0 w-full text-accent" />
          </span>
        </h1>

        <p class="mt-8 max-w-[46ch] font-sans text-base leading-relaxed text-muted">
          {profile.lead}
        </p>

        {/* No email here. The address lives on /contact and /freelance, and a
            CV a recruiter may share is the wrong place to publish it. The PDF
            download is the one action, same rule the old standalone /cv page
            followed before this page absorbed it. */}
        <div class="mt-8">
          <a
            href={withBase('/cv.pdf')}
            class="inline-flex items-center gap-2 rounded-sm border border-line px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted no-underline transition-colors hover:border-accent hover:text-accent"
          >
            {t.downloadCv}
            <span aria-hidden="true">↓</span>
          </a>
        </div>

        <p class="mt-6 font-mono text-[11px] uppercase tracking-wider text-muted">
          {profile.location} · {profile.languages}
        </p>
      </div>

      <Doodle name="xiaohei-about-hero" class="hidden shrink-0 text-ink lg:block lg:h-[22rem] lg:w-[17.3rem]" />
    </div>

    {/* The comp's own mobile node order places the illustration as its own
        full-width block between the hero text and the Care rows, not
        cropped beside the title like Article's landscape sources: this is a
        single portrait-ish 330x420 asset, shown near its own native size on
        both breakpoints rather than a viewport crop. */}
    <Doodle
      name="xiaohei-about-hero"
      class="mx-auto mt-10 aspect-[330/420] w-full max-w-[330px] text-ink lg:hidden"
    />

    <section class="mt-8 sm:mt-24">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">{t.valuesHeading}</h2>
      <ul data-principles class="mt-8 border-t border-line">
        {t.values.map((p) => (
          <li
            data-principle
            class="grid grid-cols-[2.5rem_1fr] items-baseline gap-x-5 border-b border-line py-6 sm:grid-cols-[3.5rem_16rem_1fr] sm:gap-x-10"
          >
            <span class="font-sans text-base font-medium text-ink sm:text-lg">{p.title}</span>
            <span class="col-start-2 mt-2 font-sans text-sm leading-relaxed text-muted sm:col-start-3 sm:mt-0">{p.body}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">{t.toolsHeading}</h2>
      <p data-tools class="mt-6 max-w-[60ch] font-mono text-sm leading-loose text-ink">
        {tools.join(' · ')}<span class="text-muted">{t.toolsTail}</span>
      </p>
    </section>

    <section class="mt-20">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-accent">{t.currentlyHeading}</h2>
      <ul class="mt-8 border-t border-line">
        {t.currently.map((c) => (
          <li class="grid grid-cols-[1fr] items-baseline gap-y-2 border-b border-line py-5 sm:grid-cols-[10rem_1.5rem_1fr] sm:gap-y-0">
            <span class="font-mono text-[11px] uppercase tracking-wider text-muted">{c.label}</span>
            <span aria-hidden="true" class="hidden text-muted sm:block">→</span>
            <span class="font-sans text-sm text-ink">{c.body}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
