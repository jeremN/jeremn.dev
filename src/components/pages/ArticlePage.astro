---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { readingTime } from '../../lib/reading-time'
import { withBase } from '../../lib/base'
import Underline from '../site/Underline.astro'
import Doodle from '../site/Doodle.astro'
import { illustrationForKey, articleAspectForKey } from '../../lib/article-illustrations'
import { isVisible } from '../../lib/posts'
import { getCopy, type Locale } from '../../i18n'

interface Props {
  post: CollectionEntry<'blog'>
  older: CollectionEntry<'blog'> | null
  lang: Locale
}
const { post, older, lang } = Astro.props
const t = getCopy(lang, 'article')
const { Content, headings } = await render(post)
// The pair, derived from the collection. ROUTE_MAP cannot hold it: it is a
// static table and these routes only exist once the collection is read.
// The draft filter is the same one both routes apply, and it has to be here
// too: an unfiltered lookup pairs a published article with a draft twin, and
// then advertises a URL the production build never writes.
const twin = (await getCollection('blog', isVisible)).find(
  (p) => p.data.translationKey === post.data.translationKey && p.data.lang !== post.data.lang,
)
const alternates = twin
  ? {
      en: post.data.lang === 'en' ? `/blog/${post.id}` : `/blog/${twin.id}`,
      fr: post.data.lang === 'fr' ? `/fr/blog/${post.id}` : `/fr/blog/${twin.id}`,
    }
  : null
// English keeps the comp's short month: 'SEP 17, 2026'.
// French takes the LONG month, unlike `PostRow`'s stack. This line is one
// running sentence, so a trimmed 'fr-FR' abbreviation reads as a word: '17
// SEPT 2026' is '17 seven 2026', and 'AVR' and 'JUIL' are no better. Keeping
// the period instead would fix the meaning but leave the ragged mix the stack
// was trimmed to avoid, since 'fr-FR' abbreviates eight months and leaves four
// bare. The long month removes both problems and is what French prose uses.
// `PostRow` cannot follow: its column is 3.5rem wide and 'SEPTEMBRE' overflows.
const date = post.data.publishedAt.toLocaleDateString(
  lang === 'fr' ? 'fr-FR' : 'en-US',
  lang === 'fr'
    ? { year: 'numeric', month: 'long', day: 'numeric' }
    : { year: 'numeric', month: 'short', day: 'numeric' },
)
const category = post.data.tags.join(' / ').toUpperCase()
const readTime = readingTime(post.body, lang)
// "On this page" rail — only worth showing once a post has real structure.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const showToc = toc.length >= 2
// Curated, not exhaustive: only some posts have a drawn illustration yet, and
// there is no reasonable fallback for the ones that don't (see the lib for why).
// Keyed on `translationKey`, so a translated article reuses its twin's drawing
// instead of duplicating the asset.
const illustration = illustrationForKey(post.data.translationKey)
// Each illustration keeps its own tight aspect ratio rather than a shared
// one — see the lib for why.
const illustrationAspect = articleAspectForKey(post.data.translationKey)
const blogIndex = lang === 'fr' ? '/fr/blog' : '/blog'
---
<Layout lang={lang} alternates={alternates} title={`${post.data.title} · jeremn.dev`} description={post.data.summary} hideFooterCta>
  <main
    class:list={[
      'relative z-10 mx-auto px-6 pb-24 pt-2',
      showToc
        ? 'max-w-[68ch] lg:max-w-none lg:grid lg:grid-cols-[13rem_minmax(0,68ch)] lg:justify-center lg:gap-x-20'
        : 'max-w-[68ch]',
    ]}
  >
    {showToc && (
      <aside class="hidden lg:block">
        <nav class="sticky top-24" aria-label={t.toc}>
          <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-muted">{t.toc}</span>
          <ul class="border-l border-line">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc={h.slug}
                  class:list={[
                    'toc-link -ml-px block border-l border-transparent py-1 font-mono text-xs leading-snug text-muted transition-colors hover:text-ink',
                    h.depth === 3 ? 'pl-7' : 'pl-4',
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}

    <div>
      <a data-back href={withBase(blogIndex)} class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-accent no-underline transition-opacity hover:opacity-70">
        {t.backToIndex}
      </a>

      <div class="mt-10 flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
        <div class="min-w-0">
          <p data-article-meta class="font-mono text-[11px] uppercase tracking-wider text-muted">
            {date}{category && ` · ${category}`}
          </p>

          <h1 class="mt-4 max-w-[18ch] font-display text-4xl font-medium leading-[1.1] tracking-tight text-ink sm:text-5xl">
            <span class="relative inline-block">
              {post.data.title}
              <Underline class="absolute -bottom-2 left-0 w-full text-accent" />
            </span>
          </h1>

          {post.data.summary && (
            <p class="mt-8 max-w-[44ch] font-sans text-base leading-relaxed text-muted">{post.data.summary}</p>
          )}

          <p class="mt-6 font-mono text-[11px] uppercase tracking-wider text-muted">{readTime}</p>
        </div>

        {/* Smaller than Home's hero doodle on purpose: the article column
            tops out at 68ch (this page's typographic measure), far narrower
            than Home's 1440px section, so a hero-sized mark here would crush
            the title column into single-word-per-line wrapping. Fixed box,
            same for every post: each illustration's own aspect ratio now
            varies a lot (see the lib), so letting width follow height here
            the way mobile does would blow this box out to 500px+ for the
            widest ones and crush the title column into vertical text. The
            default xMidYMid-meet letterboxes instead — never crops. */}
        {illustration && (
          <Doodle name={illustration} class="hidden shrink-0 text-ink lg:block lg:h-[9.5rem] lg:w-[17.3rem]" />
        )}

        {/* Full-bleed on mobile: -mx-6 cancels the main's own px-6 so the
            illustration reaches both edges instead of sitting inset with the
            rest of the column. */}
        {illustration && (
          <Doodle name={illustration} class="-mx-6 text-ink lg:hidden" style={`aspect-ratio: ${illustrationAspect}`} />
        )}
      </div>

    {/* The four data- attributes carry the client script's strings across a
        boundary it cannot import through. The script already reads this
        element, so it needs no second lookup and no second copy of the copy. */}
    <article
      class="prose mt-10 max-w-none prose-pre:rounded-lg prose-pre:border prose-pre:border-line"
      data-copy={t.copy}
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      data-heading-anchor={t.headingAnchor}
    >
      <Content />
    </article>

    {/* The comp offers one onward article, not two. `older` is the right one:
        a reader who finished the newest post has nowhere newer to go, and
        offering `newer` on an older post sends them backwards through a series. */}
    {older && (
      <nav data-keep-reading class="mt-24 border-t border-line pt-10">
        <span class="font-mono text-[11px] uppercase tracking-wider text-accent">{t.keepReading}</span>
        <a href={withBase(`${blogIndex}/${older.id}`)} class="group mt-4 flex items-end justify-between gap-8 no-underline">
          <span class="max-w-[20ch] font-display text-3xl font-medium leading-tight text-ink transition-colors group-hover:text-accent sm:text-4xl">
            {older.data.title}
          </span>
          <span aria-hidden="true" class="pb-2 text-2xl text-ink transition-colors duration-200 group-hover:text-accent">→</span>
        </a>
      </nav>
    )}
    </div>
  </main>
</Layout>

<script>
  // Progressive enhancement for the article reading view: a header bar
  // (language label + copy button) on each code block, and hover-revealed
  // permalinks on headings. Heading ids already exist server-side, so deep
  // links work without this; the visible # is just an affordance.
  const article = document.querySelector<HTMLElement>('article.prose')
  if (article) {
    // Read the labels off the server-rendered element rather than repeating
    // them here. A client script cannot import the Astro dictionary, and a
    // second copy would go stale one language at a time. ArticlePage always
    // emits all four, so the assertions hold.
    const ui = {
      copy: article.dataset.copy!,
      copied: article.dataset.copied!,
      failed: article.dataset.copyFailed!,
      headingAnchor: article.dataset.headingAnchor!,
    }

    article.querySelectorAll('pre').forEach((pre) => {
      const figure = document.createElement('figure')
      figure.className = 'code-block'
      const head = document.createElement('div')
      head.className = 'code-block__head'

      const label = document.createElement('span')
      label.className = 'code-block__lang'
      label.textContent = (pre.dataset.language || '').toUpperCase()

      const copy = document.createElement('button')
      copy.type = 'button'
      copy.className = 'code-block__copy'
      copy.textContent = ui.copy
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText)
          copy.textContent = ui.copied
          copy.classList.add('is-copied')
        } catch {
          copy.textContent = ui.failed
        }
        setTimeout(() => {
          copy.textContent = ui.copy
          copy.classList.remove('is-copied')
        }, 1600)
      })

      head.append(label, copy)
      pre.replaceWith(figure)
      figure.append(head, pre)
    })

    article.querySelectorAll('h2[id], h3[id]').forEach((heading) => {
      const anchor = document.createElement('a')
      anchor.className = 'heading-anchor'
      anchor.href = '#' + heading.id
      anchor.setAttribute('aria-label', ui.headingAnchor)
      anchor.textContent = '#'
      heading.append(anchor)
    })

    // Table-of-contents scroll-spy: mark the section currently in view.
    const tocLinks = new Map(
      [...document.querySelectorAll<HTMLElement>('[data-toc]')].map((a) => [a.dataset.toc, a]),
    )
    if (tocLinks.size) {
      const headings = [...article.querySelectorAll('h2[id], h3[id]')]
      const visible = new Set<Element>()
      let activeId: string | null = null
      const setActive = (id: string) => {
        if (id === activeId) return
        if (activeId) tocLinks.get(activeId)?.classList.remove('is-active')
        activeId = id
        tocLinks.get(id)?.classList.add('is-active')
      }
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) visible.add(e.target)
            else visible.delete(e.target)
          }
          const top = headings.find((h) => visible.has(h))
          if (top) setActive(top.id)
        },
        { rootMargin: '0px 0px -75% 0px' },
      )
      headings.forEach((h) => spy.observe(h))
    }
  }
</script>
