  'icon-linkedin': IconLinkedin,
  'icon-malt': IconMalt,
  'icon-map-pin': IconMapPin,
  'icon-radar': IconRadar,
} as const

export type DoodleName = keyof typeof DOODLES

interface Props {
  name: DoodleName
  class?: string
  style?: string
}
const { name, class: cls = '', style } = Astro.props
const Mark = DOODLES[name]
---
<span data-doodle={name} aria-hidden="true" class:list={['pointer-events-none block', cls]} style={style}>
  <Mark class="h-full w-full" />
</span>
