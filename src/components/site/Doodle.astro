---
// One entry point for every hand-drawn mark. Two illustration languages
// coexist here. The original abstract line-doodle set (mark-*, svc-*) keeps
// currentColor strokes plus two named fills (butter sun, lavender blob), so
// it is correct in any context by construction. The newer Xiaohei character
// set (xiaohei-*) is multi-tone: it still uses currentColor for ink outlines,
// but mixes in literal hex accents and several dedicated --color-xiaohei-*
// tokens for colours that must invert per theme.
//
// Astro's SVG components are static imports, so the whole set is named here
// rather than resolved from a path at runtime.
import Braces from '../../assets/doodles/mark-braces.svg'
import Code from '../../assets/doodles/mark-code.svg'
import DotGrid from '../../assets/doodles/mark-dotgrid.svg'
import Nodes from '../../assets/doodles/mark-nodes.svg'
import Padlock from '../../assets/doodles/mark-padlock.svg'
import Plane from '../../assets/doodles/mark-plane.svg'
import Plant from '../../assets/doodles/mark-plant.svg'
import Water from '../../assets/doodles/mark-water.svg'
import SvcAi from '../../assets/doodles/svc-ai.svg'
import SvcAutomation from '../../assets/doodles/svc-automation.svg'
import SvcBackend from '../../assets/doodles/svc-backend.svg'
import SvcPerformance from '../../assets/doodles/svc-performance.svg'
import SvcFrontend from '../../assets/doodles/svc-frontend.svg'
import SvcFullstack from '../../assets/doodles/svc-fullstack.svg'
import XiaoheiHero from '../../assets/doodles/xiaohei-hero.svg'
import XiaoheiAbout from '../../assets/doodles/xiaohei-about.svg'
import XiaoheiContact from '../../assets/doodles/xiaohei-contact.svg'
import XiaoheiMarkCode from '../../assets/doodles/xiaohei-mark-code.svg'
import XiaoheiMarkLock from '../../assets/doodles/xiaohei-mark-lock.svg'
import XiaoheiMarkCubes from '../../assets/doodles/xiaohei-mark-cubes.svg'

const DOODLES = {
  braces: Braces,
  code: Code,
  dotgrid: DotGrid,
  nodes: Nodes,
  padlock: Padlock,
  plane: Plane,
  plant: Plant,
  water: Water,
  'svc-ai': SvcAi,
  'svc-automation': SvcAutomation,
  'svc-backend': SvcBackend,
  'svc-performance': SvcPerformance,
  'svc-frontend': SvcFrontend,
  'svc-fullstack': SvcFullstack,
  'xiaohei-hero': XiaoheiHero,
  'xiaohei-about': XiaoheiAbout,
  'xiaohei-contact': XiaoheiContact,
  'xiaohei-mark-code': XiaoheiMarkCode,
  'xiaohei-mark-lock': XiaoheiMarkLock,
  'xiaohei-mark-cubes': XiaoheiMarkCubes,
} as const

export type DoodleName = keyof typeof DOODLES

interface Props {
  name: DoodleName
  class?: string
}
const { name, class: cls = '' } = Astro.props
const Mark = DOODLES[name]
---
<span data-doodle={name} aria-hidden="true" class:list={['pointer-events-none block', cls]}>
  <Mark class="h-full w-full" />
</span>
