---
// One entry point for every hand-drawn mark. Two illustration languages
// coexist here. The original abstract line-doodle set (mark-*, plus
// svc-performance) keeps currentColor strokes plus two named fills (butter
// sun, lavender blob), so it is correct in any context by construction. The
// newer Xiaohei character set (the other svc-* icons, plus xiaohei-*) is
// multi-tone: it still uses currentColor for ink outlines, but mixes in
// literal hex accents for colours that do not need to invert, the
// var(--color-surface) token for paper and highlight fills, and three
// dedicated tokens (--color-xiaohei-navy, --color-xiaohei-code-navy,
// --color-xiaohei-sky) for accents that do.
//
// Astro's SVG components are static imports, so the whole set is named here
// rather than resolved from a path at runtime.
import Braces from '../../assets/doodles/mark-braces.svg'
import Code from '../../assets/doodles/mark-code.svg'
import DotGrid from '../../assets/doodles/mark-dotgrid.svg'
import Nodes from '../../assets/doodles/mark-nodes.svg'
import Padlock from '../../assets/doodles/mark-padlock.svg'
import Plane from '../../assets/doodles/mark-plane.svg'
import Plant from '../../assets/doodles/mark-plant.svg'
import Water from '../../assets/doodles/mark-water.svg'
import SvcAi from '../../assets/doodles/svc-ai.svg'
import SvcAutomation from '../../assets/doodles/svc-automation.svg'
import SvcBackend from '../../assets/doodles/svc-backend.svg'
import SvcPerformance from '../../assets/doodles/svc-performance.svg'
import SvcFrontend from '../../assets/doodles/svc-frontend.svg'
import SvcFullstack from '../../assets/doodles/svc-fullstack.svg'
import XiaoheiHero from '../../assets/doodles/xiaohei-hero.svg'
import XiaoheiAbout from '../../assets/doodles/xiaohei-about.svg'
import XiaoheiContact from '../../assets/doodles/xiaohei-contact.svg'
import XiaoheiMarkCode from '../../assets/doodles/xiaohei-mark-code.svg'
import XiaoheiMarkLock from '../../assets/doodles/xiaohei-mark-lock.svg'
import XiaoheiMarkCubes from '../../assets/doodles/xiaohei-mark-cubes.svg'
import XiaoheiWritingHeader from '../../assets/doodles/xiaohei-writing-header.svg'
import XiaoheiWritingFooter from '../../assets/doodles/xiaohei-writing-footer.svg'
import XiaoheiWritingCode from '../../assets/doodles/xiaohei-writing-code.svg'
import XiaoheiWritingLock from '../../assets/doodles/xiaohei-writing-lock.svg'
import XiaoheiWritingCubes from '../../assets/doodles/xiaohei-writing-cubes.svg'
import XiaoheiWritingGrid from '../../assets/doodles/xiaohei-writing-grid.svg'
import XiaoheiWritingBraces from '../../assets/doodles/xiaohei-writing-braces.svg'
import XiaoheiWritingServer from '../../assets/doodles/xiaohei-writing-server.svg'
import XiaoheiArticleTenMonthsOfSvelte5 from '../../assets/doodles/xiaohei-article-ten-months-of-svelte-5.svg'
import XiaoheiArticleRenovatePartOne from '../../assets/doodles/xiaohei-article-renovate-part-one.svg'
import XiaoheiArticleRenovatePartTwo from '../../assets/doodles/xiaohei-article-renovate-part-two.svg'
import XiaoheiArticleRenovatePartThree from '../../assets/doodles/xiaohei-article-renovate-part-three.svg'
import XiaoheiArticleRenovatePartFour from '../../assets/doodles/xiaohei-article-renovate-part-four.svg'
import XiaoheiArticleBestModelStillNeedsRules from '../../assets/doodles/xiaohei-article-best-model-still-needs-rules.svg'
import XiaoheiArticleWhoChecksTheAgentsTests from '../../assets/doodles/xiaohei-article-who-checks-the-agents-tests.svg'
import XiaoheiArticleStrykerOnASvelteMonorepo from '../../assets/doodles/xiaohei-article-stryker-on-a-svelte-monorepo.svg'

const DOODLES = {
  braces: Braces,
  code: Code,
  dotgrid: DotGrid,
  nodes: Nodes,
  padlock: Padlock,
  plane: Plane,
  plant: Plant,
  water: Water,
  'svc-ai': SvcAi,
  'svc-automation': SvcAutomation,
  'svc-backend': SvcBackend,
  'svc-performance': SvcPerformance,
  'svc-frontend': SvcFrontend,
  'svc-fullstack': SvcFullstack,
  'xiaohei-hero': XiaoheiHero,
  'xiaohei-about': XiaoheiAbout,
  'xiaohei-contact': XiaoheiContact,
  'xiaohei-mark-code': XiaoheiMarkCode,
  'xiaohei-mark-lock': XiaoheiMarkLock,
  'xiaohei-mark-cubes': XiaoheiMarkCubes,
  'xiaohei-writing-header': XiaoheiWritingHeader,
  'xiaohei-writing-footer': XiaoheiWritingFooter,
  'xiaohei-writing-code': XiaoheiWritingCode,
  'xiaohei-writing-lock': XiaoheiWritingLock,
  'xiaohei-writing-cubes': XiaoheiWritingCubes,
  'xiaohei-writing-grid': XiaoheiWritingGrid,
  'xiaohei-writing-braces': XiaoheiWritingBraces,
  'xiaohei-writing-server': XiaoheiWritingServer,
  'xiaohei-article-ten-months-of-svelte-5': XiaoheiArticleTenMonthsOfSvelte5,
  'xiaohei-article-renovate-part-one': XiaoheiArticleRenovatePartOne,
  'xiaohei-article-renovate-part-two': XiaoheiArticleRenovatePartTwo,
  'xiaohei-article-renovate-part-three': XiaoheiArticleRenovatePartThree,
  'xiaohei-article-renovate-part-four': XiaoheiArticleRenovatePartFour,
  'xiaohei-article-best-model-still-needs-rules': XiaoheiArticleBestModelStillNeedsRules,
  'xiaohei-article-who-checks-the-agents-tests': XiaoheiArticleWhoChecksTheAgentsTests,
  'xiaohei-article-stryker-on-a-svelte-monorepo': XiaoheiArticleStrykerOnASvelteMonorepo,
} as const

export type DoodleName = keyof typeof DOODLES

interface Props {
  name: DoodleName
  class?: string
}
const { name, class: cls = '' } = Astro.props
const Mark = DOODLES[name]
---
<span data-doodle={name} aria-hidden="true" class:list={['pointer-events-none block', cls]}>
  <Mark class="h-full w-full" />
</span>
