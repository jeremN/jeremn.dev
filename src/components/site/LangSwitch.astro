---
import type { Locale } from '../../i18n'
import { getUi } from '../../i18n/ui'
import { withBase } from '../../lib/base'

interface Props { alternates: { en: string; fr: string } | null; lang: Locale }
const { alternates, lang } = Astro.props
// A route with no twin (a one-language article) renders
// nothing rather than a dead link.
const target = alternates ? (lang === 'fr' ? alternates.en : alternates.fr) : null
const ui = getUi(lang)
---
{target && (
  <a
    data-lang-switch
    href={withBase(target)}
    hreflang={lang === 'fr' ? 'en' : 'fr'}
    aria-label={ui.switchLabel}
    class="inline-flex min-h-touch min-w-8 shrink-0 items-center justify-center whitespace-nowrap text-muted sm:min-w-touch no-underline transition-colors hover:text-accent"
  >
    {/* The label names the destination, not the current page: a reader
        already knows what language they are on, and a control labelled
        with its own current state reads as a no-op rather than a link. */}
    <span class="font-mono text-label uppercase tracking-wider">{lang === 'fr' ? 'EN' : 'FR'}</span>
  </a>
)}
