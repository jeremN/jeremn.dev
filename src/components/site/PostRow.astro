---
import { readingTime } from '../../lib/reading-time'
import { withBase } from '../../lib/base'
import { markForTags } from '../../lib/doodles'
import Doodle from './Doodle.astro'
import type { DoodleName } from './Doodle.astro'

interface Props {
  slug: string
  title: string
  summary?: string
  tags?: string[]
  publishedAt: Date
  body?: string
  variant?: 'index' | 'teaser'
  /** Overrides the tag-derived mark. Only the 'teaser' variant (the homepage's
   * three-row preview) renders a mark at all, using this to show the three
   * Xiaohei article marks in the validated design's fixed code/lock/cubes
   * sequence, which is positional rather than tag-derived (see index.astro).
   * The 'index' variant (`/blog`'s full list) renders no mark: it added
   * nothing there and is dropped rather than kept tag-derived. */
  mark?: DoodleName
}
const {
  slug,
  title,
  summary = '',
  tags = [],
  publishedAt,
  body,
  variant = 'index',
  mark: markOverride,
} = Astro.props

// The comps stack the date over three lines: day, month, year.
const day = publishedAt.toLocaleDateString('en-US', { day: '2-digit' })
const month = publishedAt.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()
const year = publishedAt.getFullYear()
const category = tags.join(' / ').toUpperCase()
const mark = markOverride ?? markForTags(tags)
---
<a
  data-post-row
  data-variant={variant}
  href={withBase(`/blog/${slug}`)}
  class:list={[
    'group grid grid-cols-[3.5rem_1fr] items-start gap-x-5 border-b border-line py-7 no-underline sm:gap-x-10',
    variant === 'teaser' ? 'sm:grid-cols-[4.5rem_1fr_auto_2.75rem]' : 'sm:grid-cols-[4.5rem_1fr_auto]',
  ]}
>
  {/* One colour, one weight, no coloured chip. The homepage teaser and the
      full index render the date identically. */}
  <span
    data-date
    class="block py-1.5 text-center font-mono text-[11px] font-normal leading-[1.5] tracking-wide text-muted"
  >
    <span class="block">{day}</span>
    <span class="block">{month}</span>
    <span class="block">{year}</span>
  </span>

  <span class="block">
    <span data-title class="block max-w-[22ch] font-display text-xl font-medium leading-snug text-ink transition-colors duration-200 group-hover:text-accent sm:text-2xl">
      {title}
    </span>
    {variant === 'index' && summary && <span class="mt-2 block text-sm text-muted">{summary}</span>}
  </span>

  <span data-meta class="col-start-2 mt-3 block font-mono text-[10px] uppercase tracking-wider text-muted sm:col-start-3 sm:mt-1 sm:text-right">
    {category && <span class="block">{category}</span>}
    <span class="mt-1 block">{readingTime(body)}</span>
  </span>

  {/* The mark is decorative and repeats the category. Only the homepage
      teaser keeps it: on /blog's full list it added nothing beside the
      already-visible category and reading time. */}
  {variant === 'teaser' && (
    <Doodle
      name={mark}
      class="col-start-4 row-start-1 hidden h-7 w-11 self-start text-muted transition-colors duration-200 group-hover:text-accent sm:block"
    />
  )}
</a>
