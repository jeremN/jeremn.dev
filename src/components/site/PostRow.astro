---
import { readingTime } from '../../lib/reading-time'
import { withBase } from '../../lib/base'
import { markForTags } from '../../lib/doodles'
import Doodle from './Doodle.astro'

interface Props {
  slug: string
  title: string
  summary?: string
  tags?: string[]
  publishedAt: Date
  body?: string
  variant?: 'index' | 'teaser'
  accentDate?: 'butter' | 'lavender' | 'none'
}
const {
  slug,
  title,
  summary = '',
  tags = [],
  publishedAt,
  body,
  variant = 'index',
  accentDate = 'none',
} = Astro.props

// The comps stack the date over three lines: day, month, year.
const day = publishedAt.toLocaleDateString('en-US', { day: '2-digit' })
const month = publishedAt.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()
const year = publishedAt.getFullYear()
const category = tags.join(' / ').toUpperCase()
const mark = markForTags(tags)
---
<a
  data-post-row
  data-variant={variant}
  href={withBase(`/blog/${slug}`)}
  class="group grid grid-cols-[3.5rem_1fr] items-start gap-x-5 border-b border-line py-7 no-underline sm:grid-cols-[4.5rem_1fr_auto_2.75rem] sm:gap-x-10"
>
  <span
    data-date
    class:list={[
      'block rounded-sm px-2 py-1.5 text-center font-mono text-[11px] leading-[1.5] tracking-wide text-muted',
      accentDate === 'butter' && 'bg-[var(--color-chip-butter)] !text-[var(--color-chip-ink)]',
      accentDate === 'lavender' && 'bg-[var(--color-chip-lavender)] !text-[var(--color-chip-ink)]',
    ]}
  >
    <span class="block">{day}</span>
    <span class="block">{month}</span>
    <span class="block">{year}</span>
  </span>

  <span class="block">
    <span class="block max-w-[22ch] font-display text-xl font-medium leading-snug text-ink transition-[color,transform] duration-200 group-hover:translate-x-0.5 group-hover:text-accent sm:text-2xl">
      {title}
    </span>
    {variant === 'index' && summary && <span class="mt-2 block text-sm text-muted">{summary}</span>}
  </span>

  <span data-meta class="col-start-2 mt-3 block font-mono text-[10px] uppercase tracking-wider text-muted sm:col-start-3 sm:mt-1 sm:text-right">
    {category && <span class="block">{category}</span>}
    <span class="mt-1 block">{readingTime(body)}</span>
  </span>

  {/* The mark is decorative and repeats the category, so it is aria-hidden and
      only appears once there is room for a fourth column. */}
  <Doodle
    name={mark}
    class="col-start-4 row-start-1 hidden h-7 w-11 self-start text-muted transition-[color,transform] duration-200 group-hover:-translate-y-0.5 group-hover:text-accent sm:block"
  />
</a>
