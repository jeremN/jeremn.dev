---
import { readingTime } from '../../lib/reading-time'
import { withBase } from '../../lib/base'
import { markForTags } from '../../lib/doodles'
import Doodle from './Doodle.astro'
import type { DoodleName } from './Doodle.astro'
import type { Locale } from '../../i18n'

interface Props {
  slug: string
  title: string
  summary?: string
  tags?: string[]
  publishedAt: Date
  body?: string
  variant?: 'index' | 'teaser'
  /** The page's language. Drives the date locale, the reading-time noun and
   * the href prefix, all three of which used to be pinned to English. The
   * prefix is derived here rather than passed in: a separate prop could
   * disagree with `lang` and silently mix a French date into an English link.
   * Defaults to 'en' so a caller that predates the French tree still renders. */
  lang?: Locale
  /** Overrides the tag-derived mark. Only the 'teaser' variant (the homepage's
   * three-row preview) renders a mark at all, using this to show the three
   * Xiaohei article marks in the validated design's fixed code/lock/cubes
   * sequence, which is positional rather than tag-derived (see index.astro).
   * The 'index' variant (`/blog`'s full list) renders no mark: it added
   * nothing there and is dropped rather than kept tag-derived. */
  mark?: DoodleName
}
const {
  slug,
  title,
  summary = '',
  tags = [],
  publishedAt,
  body,
  variant = 'index',
  lang = 'en',
  mark: markOverride,
} = Astro.props

const blogBase = lang === 'fr' ? '/fr/blog' : '/blog'

const dateLocale = lang === 'fr' ? 'fr-FR' : 'en-US'
const date = publishedAt.toLocaleDateString(dateLocale, {
  day: '2-digit', month: 'short', year: 'numeric',
}).toUpperCase()
const category = tags.join(' / ').toUpperCase()
const mark = markOverride ?? markForTags(tags)
---
<a
  data-post-row
  data-variant={variant}
  href={withBase(`${blogBase}/${slug}`)}
  class="post-row group border-b border-line py-7 no-underline"
>
  <span class="post-content min-w-0">
    <span data-title class:list={[
      'block font-display font-medium leading-snug text-ink transition-colors duration-200 group-hover:text-accent',
      variant === 'teaser' ? 'text-[21px]' : 'max-w-[22ch] text-[23px] lg:text-[28px]',
    ]}>
      {title}
    </span>
    {variant === 'index' && summary && <span class="mt-2 block text-sm text-muted">{summary}</span>}
  </span>

  <span data-meta class="post-meta font-mono text-label uppercase tracking-wider text-muted">
    {category && <span class="post-category">{category}</span>}
    <span class="post-details">
      <span class="post-reading">{readingTime(body, lang)}</span>
      <span class="post-separator" aria-hidden="true"> · </span>
      <time data-date datetime={publishedAt.toISOString()} class="post-date font-mono text-label font-normal text-muted">{date}</time>
    </span>
  </span>

  {variant === 'teaser' && (
    <Doodle
      name={mark}
      class="post-mark h-7 w-11 text-muted transition-colors duration-200 group-hover:text-accent"
    />
  )}
</a>

<style>
  .post-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'date date' 'content mark' 'category category' 'reading reading';
    gap: 0.5rem 1rem;
    overflow-wrap: anywhere;
  }
  .post-content { grid-area: content; }
  .post-meta, .post-details { display: contents; }
  .post-date { grid-area: date; }
  .post-category { grid-area: category; }
  .post-reading { grid-area: reading; }
  .post-separator { display: none; }
  .post-row :global(.post-mark) { grid-area: mark; align-self: center; }
  .post-row[data-variant='index'] {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: 'date category' 'content content' 'reading reading';
  }
  .post-row[data-variant='index'] .post-category { text-align: right; }

  @media (min-width: 40rem) {
    .post-row, .post-row[data-variant='index'] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
      grid-template-areas: 'content meta';
      align-items: center;
      gap: 2rem;
    }
    .post-row[data-variant='teaser'] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15rem) 2.75rem;
      grid-template-areas: 'content meta mark';
    }
    .post-meta { grid-area: meta; display: block; }
    .post-category, .post-row[data-variant='index'] .post-category {
      display: block;
      text-align: left;
      font-weight: 600;
    }
    .post-details { display: block; margin-top: 0.5rem; }
    .post-separator { display: inline; }
  }
</style>
