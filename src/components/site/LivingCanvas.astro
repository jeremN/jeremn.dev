---
// The drawing layer over the hero landscape. It wraps the artwork rather than
// living inside it, because the canvas has to overlay the whole composition and
// the hotspot ids belong to the SVG.
//
// Everything here ships inert. The controls carry `hidden`, and only the client
// module reveals them, and only once the pointer guard passes. With JavaScript
// off the visitor sees the landscape and nothing else.
interface Props { class?: string }
const { class: cls = '' } = Astro.props
---
<div data-canvas-stage data-draw-mode="off" class:list={['relative', cls]}>
  <slot />

  <canvas
    data-draw-canvas
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full text-accent"
  ></canvas>

  <div data-draw-controls hidden class="absolute right-0 top-0 flex items-center gap-2">
    <button
      data-draw-toggle
      type="button"
      aria-pressed="false"
      class="rounded-sm border border-line px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider text-muted transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-ground"
    >
      Draw
    </button>
    <button
      data-draw-clear
      type="button"
      hidden
      class="rounded-sm border border-line px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider text-muted transition-colors hover:border-accent hover:text-accent"
    >
      Clear
    </button>
  </div>

  <p data-draw-hint class="mt-3 text-right font-mono text-[10px] uppercase tracking-wider text-muted opacity-0 transition-opacity">
    Hold D to draw · Esc exits · ⌘Z undoes
  </p>
</div>

<script>
  import { initLivingCanvas } from './living-canvas.client'

  const stage = document.querySelector<HTMLElement>('[data-canvas-stage]')
  if (stage) {
    try {
      initLivingCanvas(stage)
    } catch (err) {
      // Log the real error and leave the landscape alone. A broken drawing
      // layer must never cost the visitor the hero.
      console.error('[LivingCanvas] init failed:', err)
      stage.dataset.drawAvailable = 'false'
    }
  }
</script>
