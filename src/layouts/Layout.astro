---
import '../styles.css'
import { withBase, toRoute, isSubpathDeploy, absolute, pageUrl } from '../lib/base'
import { localeOf, alternatesFor, ROUTE_MAP, type Locale } from '../i18n'
import { getUi } from '../i18n/ui'
import LangSwitch from '../components/site/LangSwitch.astro'
import JsonLd from '../components/site/JsonLd.astro'
import type { JsonLdObject } from '../lib/structured-data'
interface Props {
  title?: string
  description?: string
  noindex?: boolean
  lang?: Locale
  /** Overrides the route map. `null` means "this page has no twin". */
  alternates?: { en: string; fr: string } | null
  /** This page's structured data. Built by `lib/structured-data.ts`. */
  jsonLd?: JsonLdObject
  /** Absolute URL of the social card. Articles pass their own. */
  ogImage?: string
  /** Set on an article, so the head can carry `og:type="article"` and the
   *  publication date. Every other page stays `website`. */
  article?: { publishedAt: Date } | null
}
const {
  title = 'Jérémie Néhlil',
  description = 'Jérémie Néhlil, freelance fullstack JavaScript engineer. SvelteKit, React and Node.',
  noindex = false,
  jsonLd,
  article = null,
} = Astro.props
const year = new Date().getFullYear()

// `route` is base-independent, so nav matching works under either deploy target.
const route = toRoute(Astro.url.pathname)
const isActive = (href: string) => route === href || route.startsWith(href + '/')
const canonical = pageUrl(route)

const lang: Locale = Astro.props.lang ?? localeOf(route)
const ui = getUi(lang)
// Articles pass their own rendered card. Every other page takes the site card
// for its own language: the French one writes the French job title, which is
// the line a French prospect sees when the link is shared.
const ogImage = Astro.props.ogImage ?? absolute(lang === 'fr' ? '/og/site-fr.jpg' : '/og/site.jpg')
// Nav hrefs are English routes. Under /fr/, swap each one for its twin.
const nav = ui.nav.map((n) => ({ ...n, href: lang === 'fr' ? (ROUTE_MAP[n.href] ?? n.href) : n.href }))
// An explicit prop wins. Articles pass their pair, which ROUTE_MAP cannot hold
// because it is derived from the collection at build time. The test is against
// `undefined`, not falsiness: an article with no twin passes `null` on purpose
// and must not fall back to the route map.
const alternates = Astro.props.alternates !== undefined ? Astro.props.alternates : alternatesFor(route)
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a SAVED theme before paint to avoid a flash. With no saved choice we
      // stamp nothing, so `color-scheme: light dark` lets the OS decide.
      try {
        const t = localStorage.getItem('theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" id="theme-color" content="#faf8f3" />
    <link rel="canonical" href={canonical} />
    {alternates && !isSubpathDeploy && (
      <>
        <link rel="alternate" hreflang="en" href={pageUrl(alternates.en)} />
        <link rel="alternate" hreflang="fr" href={pageUrl(alternates.fr)} />
        <link rel="alternate" hreflang="x-default" href={pageUrl(alternates.en)} />
      </>
    )}
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.json')} />
    {/* Both feeds are advertised on every page, each titled in its own
        language, so a reader subscribing from either tree can pick. */}
    <link rel="alternate" type="application/rss+xml" title="jeremn.dev · Writing" href={withBase('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title="jeremn.dev · Articles" href={withBase('/fr/rss.xml')} />
    {(noindex || isSubpathDeploy) && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedAt.toISOString()} />
        <meta property="article:author" content="Jérémie Néhlil" />
      </>
    )}
    <meta property="og:site_name" content="jeremn.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Skipped on the subpath deploy for the same reason as hreflang above:
        `withBase` puts the project prefix into the path, so every URL in the
        block would resolve against the apex origin and come out wrong. */}
    {jsonLd && !isSubpathDeploy && <JsonLd data={jsonLd} />}
  </head>
  <body class:list={['antialiased', '[overflow-wrap:anywhere]']}>
    <header
      id="site-header"
      class="sticky top-0 z-30 h-[72px] border-b border-transparent bg-ground/80 backdrop-blur-md transition-[height,border-color] duration-300 ease-out"
    >
      <div class="mx-auto flex h-full max-w-[1440px] items-center justify-between px-4 sm:px-6">
        <a href={withBase(lang === 'fr' ? '/fr/' : '/')} class="inline-flex min-h-touch shrink-0 items-center whitespace-nowrap font-sans text-base font-bold tracking-tight text-ink no-underline sm:text-lg">
          <span>jeremn<span class="text-accent">.</span>dev</span>
        </a>
        <div class="flex min-w-0 items-center gap-1 sm:gap-9">
          {/* Below 40rem the four links no longer fit beside the wordmark and
              the two controls, so they move into the side panel below. */}
          <nav
            class="hidden min-w-0 gap-8 sm:flex"
            aria-label={ui.navLabel}
          >
            {nav.map((n) => (
              <a href={withBase(n.href)} class="group inline-flex min-h-touch shrink-0 items-center justify-center whitespace-nowrap no-underline sm:min-w-touch" aria-current={isActive(n.href) ? 'page' : undefined}>
                <span class:list={['site-nav-label font-sans text-muted transition-colors group-hover:text-ink', isActive(n.href) && '!text-ink']}>{n.label}</span>
              </a>
            ))}
          </nav>
          <LangSwitch alternates={alternates} lang={lang} />
          <button
            id="theme-toggle"
            type="button"
            aria-label={ui.themeToggleLabel}
            class="flex min-h-touch min-w-8 shrink-0 items-center justify-center text-muted transition-colors hover:text-accent sm:min-w-touch"
          >
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4" />
              <path d="M8 1a7 7 0 0 1 0 14z" fill="currentColor" />
            </svg>
          </button>
          <button
            id="menu-open"
            type="button"
            aria-label={ui.menuOpenLabel}
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-haspopup="dialog"
            class="-mr-2 flex min-h-touch min-w-touch shrink-0 items-center justify-center text-ink transition-colors hover:text-accent sm:hidden"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    {/* A native modal <dialog>: showModal() gives the focus trap, Escape to
        close, and an inert page behind it, without a line of script for any
        of the three. It sits outside <header> so `header nav a` still means
        the desktop row alone. */}
    <dialog
      id="mobile-menu"
      aria-label={ui.navLabel}
      class="mobile-menu m-0 ml-auto h-dvh max-h-none w-[min(20rem,85vw)] max-w-none border-l border-line bg-ground p-0 text-ink sm:hidden"
    >
      <div class="flex h-full flex-col px-6 pb-8">
        <div class="flex h-[72px] shrink-0 items-center justify-end">
          <button
            id="menu-close"
            type="button"
            aria-label={ui.menuCloseLabel}
            class="-mr-2 flex min-h-touch min-w-touch items-center justify-center text-muted transition-colors hover:text-accent"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        {/* Unlabelled: the dialog already carries the name, and a second
            "Main" landmark would duplicate the desktop one. */}
        <nav class="mt-4 flex flex-col border-t border-line">
          {nav.map((n) => (
            <a
              href={withBase(n.href)}
              aria-current={isActive(n.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-14 items-center justify-between border-b border-line font-sans text-2xl font-semibold tracking-tight no-underline transition-colors hover:text-accent',
                isActive(n.href) ? 'text-ink' : 'text-muted',
              ]}
            >
              <span>{n.label}</span>
              {isActive(n.href) && <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />}
            </a>
          ))}
        </nav>
        <div class="mt-auto flex flex-col gap-1 font-mono text-label text-muted">
          <span>{ui.basedIn}</span>
          <span>{ui.remote}</span>
        </div>
      </div>
    </dialog>

    <slot />

    <footer class="relative z-10 border-t border-line bg-ground">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6">
        {/* Mobile: the copyright takes the first line, the two meta items
            share the second, pushed to either edge. One row from 40rem. */}
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-6 font-mono text-label text-muted sm:py-8">
          <span class="basis-full sm:basis-auto">© {year} jeremn.dev</span>
          <span>{ui.basedIn}</span>
          <span>{ui.remote}</span>
        </div>
      </div>
    </footer>

    <script>
      // Reads the resolved --color-ground off document.body's computed style
      // rather than duplicating the palette's hex values here. A custom
      // property itself computes to the unresolved `light-dark(...)` token
      // stream, but the property a rule actually assigns (body's
      // background-color) resolves to `rgb(r, g, b)`, which stays correct
      // even after Task 3 swaps the palette.
      const syncMeta = () => {
        const ground = getComputedStyle(document.body).backgroundColor
        document.getElementById('theme-color')?.setAttribute('content', ground)
      }

      const effective = (): 'light' | 'dark' =>
        (document.documentElement.dataset.theme as 'light' | 'dark' | undefined) ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')

      syncMeta()

      // With no stored choice, the OS preference decides the theme (see the
      // inline script in <head>). Sync the meta on every OS change too, so
      // browser chrome does not go stale while the page stays open.
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (!document.documentElement.dataset.theme) syncMeta()
      })

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = effective() === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = next
        syncMeta()
        try {
          localStorage.setItem('theme', next)
        } catch (e) {}
      })

      // Mobile menu. The dialog handles focus trapping and Escape natively;
      // this wires the two buttons, a tap on the backdrop, and aria-expanded.
      const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null
      const menuOpen = document.getElementById('menu-open')
      if (menu && menuOpen) {
        menuOpen.addEventListener('click', () => {
          menu.showModal()
          menuOpen.setAttribute('aria-expanded', 'true')
        })
        document.getElementById('menu-close')?.addEventListener('click', () => menu.close())
        // A click whose target is the dialog element itself landed on the
        // ::backdrop, since the panel's content fills the whole box.
        menu.addEventListener('click', (e) => {
          if (e.target === menu) menu.close()
        })
        menu.addEventListener('close', () => menuOpen.setAttribute('aria-expanded', 'false'))
        // Rotating a phone to landscape can cross 40rem with the panel open,
        // where the dialog is display:none but still modal. Close it.
        matchMedia('(min-width: 40rem)').addEventListener('change', (e) => {
          if (e.matches && menu.open) menu.close()
        })
      }

      // Header shrinks 72px → 56px past the first screenful and gains a
      // hairline. rAF-throttled: a raw scroll handler that writes classes
      // fires far more often than the compositor can use.
      const header = document.getElementById('site-header')
      if (header) {
        let ticking = false
        const sync = () => {
          const compact = window.scrollY > 24
          header.classList.toggle('h-[56px]', compact)
          header.classList.toggle('h-[72px]', !compact)
          header.classList.toggle('border-line', compact)
          header.classList.toggle('border-transparent', !compact)
          ticking = false
        }
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true
              requestAnimationFrame(sync)
            }
          },
          { passive: true },
        )
        sync()
      }
    </script>
  </body>
</html>
