---
import '../styles.css'
import { withBase, toRoute, isSubpathDeploy } from '../lib/base'
interface Props { title?: string; description?: string; noindex?: boolean; hideFooterCta?: boolean }
const {
  title = 'Jérémie Néhlil',
  description = 'Jérémie Néhlil, freelance software engineer. CV, writing, and a WebGL galaxy.',
  noindex = false,
  hideFooterCta = false,
} = Astro.props
// Five primary destinations, matching the comp minus Stack (dropped: no page
// backs it). Services now has its own route (the comp's header carries a
// link for it), so it joins the nav. /freelance predates it and covers
// overlapping ground; Contact covers the same intent, so /freelance stays
// reachable only by direct URL rather than through nav or footer.
const nav = [
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
]
const year = new Date().getFullYear()

// `route` is base-independent, so nav matching works under either deploy target.
const route = toRoute(Astro.url.pathname)
const isActive = (href: string) => route === href || route.startsWith(href + '/')
const canonical = Astro.site ? new URL(withBase(route), Astro.site).href : withBase(route)
const ogImage = Astro.site ? new URL(withBase('/og-cover.jpg'), Astro.site).href : withBase('/og-cover.jpg')
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a SAVED theme before paint to avoid a flash. With no saved choice we
      // stamp nothing, so `color-scheme: light dark` lets the OS decide.
      try {
        const t = localStorage.getItem('theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" id="theme-color" content="#faf8f3" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.json')} />
    {(noindex || isSubpathDeploy) && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="jeremn.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class:list={['antialiased', '[overflow-wrap:anywhere]']}>
    <header
      id="site-header"
      class="sticky top-0 z-30 h-[72px] border-b border-transparent bg-ground/80 backdrop-blur-md transition-[height,border-color] duration-300 ease-out"
    >
      <div class="mx-auto flex h-full max-w-[1440px] items-center justify-between px-4 sm:px-6">
        <a href={withBase('/')} class="whitespace-nowrap font-sans text-base font-bold tracking-tight text-ink no-underline sm:text-lg">
          jeremn<span class="text-accent">.</span>dev
        </a>
        <div class="flex min-w-0 items-center gap-3 sm:gap-9">
          <nav
            class="flex min-w-0 gap-3 overflow-x-auto [scrollbar-width:none] sm:gap-8 [&::-webkit-scrollbar]:hidden"
            aria-label="Main"
          >
            {nav.map((n) => (
              <a href={withBase(n.href)} class="group whitespace-nowrap no-underline" aria-current={isActive(n.href) ? 'page' : undefined}>
                <span class:list={['font-sans text-xs text-muted transition-colors group-hover:text-ink sm:text-sm', isActive(n.href) && '!text-ink']}>{n.label}</span>
              </a>
            ))}
          </nav>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Switch between light and dark theme"
            class="-my-1 flex items-center text-muted transition-colors hover:text-accent"
          >
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4" />
              <path d="M8 1a7 7 0 0 1 0 14z" fill="currentColor" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="relative z-10 border-t border-line bg-ground">
      <div class="mx-auto max-w-[1440px] px-6">
        {!hideFooterCta && (
          <div class="py-20 sm:py-28">
            <span class="font-mono text-[11px] uppercase tracking-wider text-accent">Get in touch</span>
            <a href={withBase('/contact')} class="mt-3 block no-underline">
              <h2 class="font-display text-5xl font-semibold leading-none tracking-tight text-ink transition-colors hover:text-accent sm:text-7xl">
                Work with me
              </h2>
            </a>
          </div>
        )}
        <div
          class:list={[
            'flex flex-col gap-3 py-8 font-mono text-[11px] text-muted sm:flex-row sm:items-center sm:justify-between',
            !hideFooterCta && 'border-t border-line',
          ]}
        >
          <span>© {year} jeremn.dev</span>
          <span>Based in France</span>
          <span>Remote friendly</span>
        </div>
      </div>
    </footer>

    <script>
      // Reads the resolved --color-ground off document.body's computed style
      // rather than duplicating the palette's hex values here. A custom
      // property itself computes to the unresolved `light-dark(...)` token
      // stream, but the property a rule actually assigns (body's
      // background-color) resolves to `rgb(r, g, b)`, which stays correct
      // even after Task 3 swaps the palette.
      const syncMeta = () => {
        const ground = getComputedStyle(document.body).backgroundColor
        document.getElementById('theme-color')?.setAttribute('content', ground)
      }

      const effective = (): 'light' | 'dark' =>
        (document.documentElement.dataset.theme as 'light' | 'dark' | undefined) ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')

      syncMeta()

      // With no stored choice, the OS preference decides the theme (see the
      // inline script in <head>). Sync the meta on every OS change too, so
      // browser chrome does not go stale while the page stays open.
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (!document.documentElement.dataset.theme) syncMeta()
      })

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = effective() === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = next
        syncMeta()
        try {
          localStorage.setItem('theme', next)
        } catch (e) {}
      })

      // Header shrinks 72px → 56px past the first screenful and gains a
      // hairline. rAF-throttled: a raw scroll handler that writes classes
      // fires far more often than the compositor can use.
      const header = document.getElementById('site-header')
      if (header) {
        let ticking = false
        const sync = () => {
          const compact = window.scrollY > 24
          header.classList.toggle('h-[56px]', compact)
          header.classList.toggle('h-[72px]', !compact)
          header.classList.toggle('border-line', compact)
          header.classList.toggle('border-transparent', !compact)
          ticking = false
        }
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true
              requestAnimationFrame(sync)
            }
          },
          { passive: true },
        )
        sync()
      }
    </script>
  </body>
</html>
