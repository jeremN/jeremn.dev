{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // `public/` is copied verbatim and never type-checked. It also holds large
  // binary artifacts (the CV PDFs, the social cards), which `include: **/*`
  // would otherwise pull into the TS program.
  "exclude": ["dist", "public"]
}
